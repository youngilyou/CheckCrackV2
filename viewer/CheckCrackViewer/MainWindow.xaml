<Window x:Class="CheckCrackViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CheckCrackViewer.ViewModels"
        xmlns:views="clr-namespace:CheckCrackViewer.Views"
        Title="SmartCrack Viewer"
        Width="1500" Height="940" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Hamburger sidebar nav item: full-width, left-aligned, transparent unless the
             menu key in Tag matches SelectedMenu (highlighted via a left accent bar). -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Command" Value="{Binding SelectMenuCommand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource TwoStringsEqualToBrushConverter}">
                                        <Binding Path="SelectedMenu"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="CommandParameter"/>
                                    </MultiBinding>
                                </Border.Background>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 이 앱 최초의 TabControl(설정 페이지 계정/연결 · 시스템 상태) — Button과 마찬가지로
             기본 크롬(밝은 Aero 그라디언트)이 다크 테마와 충돌해서 완전 커스텀
             ControlTemplate 필요(Expander처럼 브러시만 얹는 걸로는 부족). Window 범위 암시적
             스타일이라 다른 창에는 영향 없음. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Background="Transparent" Margin="0,0,0,-1"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,16,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 단지(Complex) 노드: 최상위 레벨. Children은 BuildingNode/SideGroupNode가
             섞여 있을 수 있음(동은 선택 사항) — 아래 두 암시적 템플릿이 알아서 구분해 그림. -->
        <DataTemplate DataType="{x:Type vm:ComplexNode}">
            <Expander Style="{StaticResource TreeGroupExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ComplexName}" FontWeight="Bold" FontSize="13.5"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="단지 종합보고서" Padding="6,1" FontSize="10"
                                Command="{Binding DataContext.GenerateBuildingReportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Children}" Margin="12,2,0,0"/>
            </Expander>
        </DataTemplate>

        <!-- 동(Building) 노드: 선택 사항 레벨. -->
        <DataTemplate DataType="{x:Type vm:BuildingNode}">
            <Expander Style="{StaticResource TreeGroupExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding BuildingName}" FontWeight="Bold" FontSize="12.5"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="동 종합보고서" Padding="6,1" FontSize="10"
                                Command="{Binding DataContext.GenerateBuildingReportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Children}" Margin="12,2,0,0"/>
            </Expander>
        </DataTemplate>

        <!-- 방위(Side) 그룹: 최하위 그룹핑, 실제 Facade 카드를 담는 leaf 컨테이너. -->
        <DataTemplate DataType="{x:Type vm:SideGroupNode}">
            <Expander Style="{StaticResource TreeGroupExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <TextBlock Text="{Binding Side}" FontSize="11.5" Foreground="{StaticResource Text2}"/>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Facades}" Margin="10,0,0,0"/>
            </Expander>
        </DataTemplate>

        <!-- Facade 카드(leaf) — 기존 ListBox.ItemTemplate 내용 그대로, 선택은 더 이상
             ListBoxItem.IsSelected가 아니라 Border의 MouseBinding + SelectFacadeCommand +
             ReferenceEqualsToBrushConverter(참조 비교 하이라이트)로 처리. -->
        <DataTemplate DataType="{x:Type vm:FacadeItemViewModel}">
            <Border Background="{StaticResource Surface2}" CornerRadius="7" Padding="10,8" Margin="0,3" BorderThickness="1" Cursor="Hand">
                <Border.BorderBrush>
                    <MultiBinding Converter="{StaticResource ReferenceEqualsToBrushConverter}">
                        <Binding/>
                        <Binding Path="DataContext.SelectedFacade" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                </Border.BorderBrush>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectFacadeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,3,8,0" VerticalAlignment="Top"
                             Fill="{Binding OverallStatus, Converter={StaticResource StatusToColorConverter}}"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding FacadeId}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="{Binding CurrentStageLabel}" Foreground="{StaticResource Text2}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding CoverageRatio, Converter={StaticResource RatioToPercentConverter}}" FontSize="10.5" Foreground="{StaticResource Text2}" FontFamily="Consolas"/>
                            <TextBlock Text=" · " FontSize="10.5" Foreground="{StaticResource Text2}"/>
                            <TextBlock Text="{Binding OverallStatus, Converter={StaticResource StatusToLabelConverter}}" FontSize="10.5" Foreground="{StaticResource Text2}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding SourceFolderPath, Converter={StaticResource TruthyToVisibilityConverter}}">
                                <Button Content="▶ 실행" Padding="8,2" FontSize="10.5"
                                        Command="{Binding DataContext.RunFacadeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                                <TextBlock Text="실행 중…" FontSize="10.5" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                           Visibility="{Binding IsRunning, Converter={StaticResource TruthyToVisibilityConverter}}"/>
                            </StackPanel>
                            <Button Content="분류 변경" Padding="8,2" FontSize="10.5" Margin="6,0,0,0"
                                    Command="{Binding DataContext.ReclassifyFacadeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- LogEntryTemplate: App.xaml로 이동 (MainWindow의 LIVE LOG와 SettingsView의
             "오류/로그" 카드가 서로 다른 XAML 파일에서 공유). -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ toolbar ============ -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Surface2}" CornerRadius="4" Padding="8,2">
                        <TextBlock Text="{Binding RootPath}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding LoggedInUsername, Converter={StaticResource TruthyToVisibilityConverter}}">
                    <TextBlock Text="{Binding LoggedInUsername, StringFormat='로그인: {0}'}" Foreground="{StaticResource Text2}" FontSize="11.5"
                               VerticalAlignment="Center"/>
                    <Button Content="로그아웃" Command="{Binding LogoutCommand}" Margin="10,0,0,0"
                            Background="Transparent" BorderThickness="0" Padding="4,2"
                            Foreground="{StaticResource Accent}" FontSize="11.5" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ hamburger sidebar + content ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- === hamburger sidebar === -->
            <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="☰" Command="{Binding ToggleMenuCommand}"
                            Background="Transparent" BorderThickness="0" FontSize="18" Padding="14,12"
                            HorizontalContentAlignment="Left" Foreground="{StaticResource Text}" Cursor="Hand"/>
                    <Button DockPanel.Dock="Bottom" Command="{Binding ExitApplicationCommand}"
                            Background="Transparent" BorderThickness="0" Padding="14,12"
                            HorizontalContentAlignment="Left" Foreground="{StaticResource Text}" Cursor="Hand"
                            ToolTip="종료">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏻" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="종료" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Visibility="{Binding MenuCollapsed, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>
                    <StackPanel DockPanel.Dock="Top">
                        <Button Style="{StaticResource SidebarNavButton}" CommandParameter="dashboard" AutomationProperties.Name="작업 현황">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="작업 현황" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Visibility="{Binding MenuCollapsed, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarNavButton}" CommandParameter="analysis" AutomationProperties.Name="분석 · 스티칭">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧩" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="분석 · 스티칭" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Visibility="{Binding MenuCollapsed, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarNavButton}" CommandParameter="results-compare" AutomationProperties.Name="결과보기">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="결과보기" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Visibility="{Binding MenuCollapsed, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarNavButton}" CommandParameter="original-ai" AutomationProperties.Name="원본 AI">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📷" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="원본 AI" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Visibility="{Binding MenuCollapsed, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarNavButton}" CommandParameter="training" AutomationProperties.Name="AI 학습">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🤖" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="AI 학습" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Visibility="{Binding MenuCollapsed, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarNavButton}" CommandParameter="settings" AutomationProperties.Name="설정">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="설정" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Visibility="{Binding MenuCollapsed, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- === content: one page per hamburger menu item === -->
            <Grid Grid.Column="1">

                <!-- === 작업 현황: 12개 상태 카테고리 전체 facade 집계 === -->
                <Grid Visibility="{Binding SelectedMenu, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=dashboard}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28">
                            <TextBlock Text="작업 현황" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,0,0,6"/>
                            <TextBlock Text="누락 재촬영 필요 · 정밀촬영 필요는 이 Viewer가 촬영 단계를 직접 관측하지 않아 항상 0으로 표시됩니다."
                                       Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                            <ItemsControl ItemsSource="{Binding DashboardCounts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text2}" FontSize="11"/>
                                                <TextBlock Text="{Binding Count}" FontSize="28" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource Text}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- === 분석 · 스티칭: 기존 3단 화면 그대로 === -->
                <Grid Visibility="{Binding SelectedMenu, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=analysis}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 원래 상단 툴바에 있던 새로고침/폴더 선택: 분석 · 스티칭 페이지 전용 동작이라 이쪽으로 이동.
                 배경을 흰색 detail panel과 구분되는 Surface 색으로 줘서 이게 툴바라는 게 보이게 함
                 (배경 없이 버튼만 떠 있으면 아래 흰 패널과 경계가 안 보여서 헷갈림). -->
                    <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,10">
                            <Button Content="결과 새로고침" Command="{Binding RefreshNowCommand}" Margin="0,0,8,0"/>
                            <Button Content="작업 결과 열기" Command="{Binding BrowseRootCommand}"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="220" MinHeight="120"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- === facade list === -->
                        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="14,10,10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FACADES" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="이미지 폴더 추가" Command="{Binding BrowseImagesFolderCommand}"
                                Padding="8,3" FontSize="11"
                                ToolTip="이미지 폴더 선택 — 하위 폴더가 있으면 각각 별도 facade로, 없으면 선택한 폴더 자체를 하나의 facade로 추가"/>
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,0">
                                    <ItemsControl ItemsSource="{Binding FacadeTree}" Margin="0,0,0,10"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- === detail panel === -->
                        <Grid Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="왼쪽에서 facade를 선택하세요" Foreground="{StaticResource Text2}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SelectedFacade, Converter={StaticResource FalsyToVisibilityConverter}}"/>

                            <ScrollViewer Visibility="{Binding SelectedFacade, Converter={StaticResource TruthyToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20" DataContext="{Binding SelectedFacade}">

                                    <!-- header -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding FacadeId}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                                        <Border Background="{Binding OverallStatus, Converter={StaticResource StatusToColorConverter}}"
                                    CornerRadius="10" Padding="10,3" Margin="12,4,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OverallStatus, Converter={StaticResource StatusToLabelConverter}}"
                                           FontSize="11" FontWeight="Bold" Foreground="#14181A"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentStageLabel}" Foreground="{StaticResource Text2}" Margin="0,0,0,18"/>

                                    <!-- run history: read-only list of past 실행 versions
                             (V001/V002/...), populated from output/version_index.json.
                             비어있으면(레거시 facade, 아직 버전 이력 없음) 전체 숨김. -->
                                    <StackPanel Visibility="{Binding RunVersions.Count, Converter={StaticResource TruthyToVisibilityConverter}}">
                                        <TextBlock Text="실행 이력" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding RunVersions}" Margin="0,0,0,20">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CardBorder}" Padding="8,6" Margin="0,0,0,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Version}" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource Text}"/>
                                                            <TextBlock Text=" (현재)" FontWeight="Bold" Foreground="{StaticResource Accent}" FontSize="11"
                                                           Visibility="{Binding IsCurrent, Converter={StaticResource TruthyToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding CreatedAt, StringFormat=' — yyyy-MM-dd HH:mm'}" Foreground="{StaticResource Text2}" FontSize="11"/>
                                                            <TextBlock Text="{Binding CreatedBy, StringFormat=' by {0}'}" Foreground="{StaticResource Text2}" FontSize="11"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- metrics -->
                                    <TextBlock Text="스티칭 지표 (H 체인)" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                    <UniformGrid Columns="4" Margin="0,0,0,20">
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="이미지 수" Foreground="{StaticResource Text2}" FontSize="11"/>
                                                <TextBlock Text="{Binding ImageCount}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource Text}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="Coverage" Foreground="{StaticResource Text2}" FontSize="11"/>
                                                <TextBlock Text="{Binding CoverageRatio, Converter={StaticResource RatioToPercentConverter}}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource Text}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="평균 Inlier 비율" Foreground="{StaticResource Text2}" FontSize="11"/>
                                                <TextBlock Text="{Binding MeanInlierRatio, Converter={StaticResource RatioToPercentConverter}}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource Text}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorder}">
                                            <StackPanel>
                                                <TextBlock Text="Drift Score" Foreground="{StaticResource Text2}" FontSize="11"/>
                                                <TextBlock Text="{Binding GlobalDriftScorePx, Converter={StaticResource PxValueConverter}}" FontSize="20" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="{StaticResource Accent}"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- COLMAP section -->
                                    <StackPanel Visibility="{Binding HasColmapReport, Converter={StaticResource TruthyToVisibilityConverter}}">
                                        <TextBlock Text="CM Fallback" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                        <UniformGrid Columns="4" Margin="0,0,0,20">
                                            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="등록 / 요청" Foreground="{StaticResource Text2}" FontSize="11"/>
                                                    <TextBlock FontSize="20" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource Text}">
                                            <Run Text="{Binding ColmapRegistered, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding ColmapRequested, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="재투영 오차" Foreground="{StaticResource Text2}" FontSize="11"/>
                                                    <TextBlock Text="{Binding ColmapMeanReprojectionErrorPx, Converter={StaticResource PxValueConverter}}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource Text}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0"
                                        Visibility="{Binding HasRectifiedMosaic, Converter={StaticResource TruthyToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="보정 후 Coverage" Foreground="{StaticResource Text2}" FontSize="11"/>
                                                    <TextBlock Text="{Binding CoverageRatioColmap, Converter={StaticResource RatioToPercentConverter}}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource Text}"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- crack section -->
                                    <TextBlock Text="Crack Segmentation" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="스티칭을 먼저 완료해야 크랙 검사를 실행할 수 있습니다." Foreground="{StaticResource Text2}" FontSize="12"
                                           Visibility="{Binding HasMosaic, Converter={StaticResource FalsyToVisibilityConverter}}"/>

                                            <StackPanel Visibility="{Binding HasMosaic, Converter={StaticResource TruthyToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasCrackResults, Converter={StaticResource TruthyToVisibilityConverter}}">
                                                    <TextBlock Text="탐지된 crack: " Foreground="{StaticResource Text2}"/>
                                                    <TextBlock Text="{Binding CrackCount}" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource Text}"/>
                                                    <TextBlock Text="  (현재 모델은 도메인 갭으로 오탐 가능 — 육안 확인 필요)" Foreground="{StaticResource Text2}" FontSize="11"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button Content="크랙 검사 실행 (같은 버전 내 재실행 시 ID 유지)" Padding="8,2" FontSize="10.5"
                                                Command="{Binding DataContext.DetectCracksCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsDetectingCracks, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                                                    <TextBlock Text="검사 중…" FontSize="10.5" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsDetectingCracks, Converter={StaticResource TruthyToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- report section -->
                                    <TextBlock Text="검사 보고서" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="크랙 검사를 먼저 실행해야 보고서를 생성할 수 있습니다." Foreground="{StaticResource Text2}" FontSize="12"
                                           Visibility="{Binding HasCrackResults, Converter={StaticResource FalsyToVisibilityConverter}}"/>

                                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasCrackResults, Converter={StaticResource TruthyToVisibilityConverter}}">
                                                <Button Content="보고서 생성" Padding="8,2" FontSize="10.5"
                                            Command="{Binding DataContext.GenerateReportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsGeneratingReport, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                                                <TextBlock Text="생성 중…" FontSize="10.5" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                               Visibility="{Binding IsGeneratingReport, Converter={StaticResource TruthyToVisibilityConverter}}"/>
                                                <Button Content="PDF 열기" Padding="8,2" FontSize="10.5" Margin="8,0,0,0"
                                            Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding HasReport, Converter={StaticResource TruthyToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- live stitching preview: only while this facade is actively
                             running via the "+ 폴더" / "▶ 실행" flow. Each update writes a
                             freshly-numbered file (see PREVIEW_UPDATED handling), so binding
                             straight to LivePreviewImagePath naturally refreshes the image
                             every time without any manual cache-busting. -->
                                    <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource TruthyToVisibilityConverter}}"
                                    Margin="0,0,0,20">
                                        <TextBlock Text="실시간 스티칭 미리보기" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                        <Border Style="{StaticResource CardBorder}">
                                            <StackPanel>
                                                <TextBlock Text="이미지가 하나씩 채워집니다 — 완료 전까지는 대략적인 미리보기입니다 (더블클릭하면 확대)"
                                               FontSize="10.5" Foreground="{StaticResource Text2}" Margin="0,0,0,6"/>
                                                <Image Source="{Binding LivePreviewImagePath, Converter={StaticResource PathToBitmapConverter}}"
                                           MaxHeight="320" Stretch="Uniform" HorizontalAlignment="Left" Cursor="Hand"
                                           MouseLeftButtonDown="LivePreview_MouseLeftButtonDown"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- images -->
                                    <TextBlock Text="모자이크 미리보기" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,20">
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8"
                                    Visibility="{Binding VisualColmapImagePath, Converter={StaticResource TruthyToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="보정본 (visual_CM) — 더블클릭하면 확대" FontSize="10.5" Foreground="{StaticResource Text2}" Margin="0,0,0,6"/>
                                                <Image Source="{Binding VisualColmapImagePath, Converter={StaticResource PathToBitmapConverter}}"
                                           MaxHeight="260" Stretch="Uniform" HorizontalAlignment="Left" Cursor="Hand"
                                           Tag="{Binding VisualColmapImagePath}" MouseLeftButtonDown="Image_MouseLeftButtonDown"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8"
                                    Visibility="{Binding VisualImagePath, Converter={StaticResource TruthyToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="visual (H 체인) — 더블클릭하면 확대" FontSize="10.5" Foreground="{StaticResource Text2}" Margin="0,0,0,6"/>
                                                <Image Source="{Binding VisualImagePath, Converter={StaticResource PathToBitmapConverter}}"
                                           MaxHeight="260" Stretch="Uniform" HorizontalAlignment="Left" Cursor="Hand"
                                           Tag="{Binding VisualImagePath}" MouseLeftButtonDown="Image_MouseLeftButtonDown"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- issues -->
                                    <TextBlock Text="이슈 / 경고" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Issues}" Margin="0,0,0,20">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Surface2}" CornerRadius="5" Padding="8,6" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="#E0B13B"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- === live log === -->
                        <GridSplitter Grid.Row="1" Grid.Column="1"
                          Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="{StaticResource Border}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

                        <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="14,12,14,6">
                                    <TextBlock Text="LIVE LOG" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
                                    <Button Content="지우기" Command="{Binding ClearLogCommand}" HorizontalAlignment="Right" Padding="8,3" FontSize="11"/>
                                </Grid>
                                <ListBox x:Name="LogListBox" ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0"
                             ItemTemplate="{StaticResource LogEntryTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- === 원본 AI: 원본 사진 단위 YOLO 크랙 후보 확인 === -->
                <Grid Visibility="{Binding SelectedMenu, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=original-ai}">
                    <views:OriginalAiView DataContext="{Binding OriginalAi}"/>
                </Grid>

                <!-- === 결과보기: facade별 원본/스티칭/보고서 비교 === -->
                <Grid Visibility="{Binding SelectedMenu, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=results-compare}">
                    <views:ResultsCompareView DataContext="{Binding ResultsCompare}"/>
                </Grid>

                <!-- === AI 학습: Crack Box Annotator (tools/crack_annotator/template.html 이식) === -->
                <Grid Visibility="{Binding SelectedMenu, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=training}">
                    <views:AiTrainingView DataContext="{Binding AiTraining}"/>
                </Grid>

                <!-- === 설정: 계정/연결(MySQL) · 시스템 상태 (Views/SettingsView.xaml로 분리) === -->
                <Grid Visibility="{Binding SelectedMenu, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=settings}">
                    <views:SettingsView/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
