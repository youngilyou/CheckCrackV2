<UserControl x:Class="CheckCrackViewer.Views.ResultsCompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CheckCrackViewer.ViewModels"
             xmlns:models="clr-namespace:CheckCrackViewer.Models"
             xmlns:services="clr-namespace:CheckCrackViewer.Services"
             d:DataContext="{d:DesignInstance Type=vm:ResultsCompareViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- 패널 하나 안에서 재사용하는 모드별 서브뷰: DataContext는 ComparePanelState -->
        <DataTemplate x:Key="OriginalSubView" DataType="{x:Type models:ComparePanelState}">
            <Grid>
                <TextBlock Text="원본 이미지가 없습니다." Foreground="{StaticResource Text2}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasOriginalImageList, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                <DockPanel Visibility="{Binding HasOriginalImageList, Converter={StaticResource TruthyToVisibilityConverter}}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="◀ 이전" Margin="0,0,6,0"
                                Command="{Binding DataContext.PreviousOriginalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <TextBlock Text="{Binding OriginalImageLabel}" Foreground="{StaticResource Text2}" FontFamily="Consolas"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="다음 ▶" Margin="0,0,12,0"
                                Command="{Binding DataContext.NextOriginalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="－"
                                Command="{Binding DataContext.ZoomOutPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding ZoomFactor, StringFormat={}{0:0%}}" Foreground="{StaticResource Text2}"
                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button Content="＋"
                                Command="{Binding DataContext.ZoomInPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Margin="0,0,4,0"/>
                        <Button Content="전체 보기" Margin="0,0,4,0" Click="FitZoomButton_Click"/>
                        <Button Content="원본 크기"
                                Command="{Binding DataContext.ResetZoomPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Click="ResetZoomButton_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="우클릭 드래그로 이동 · 휠로 줌" FontSize="10" Foreground="{StaticResource Text2}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <!-- 우클릭 드래그로 이동, 휠로 줌. 이동을 우클릭 드래그가 전담하므로
                         ScrollViewer 기본 휠-스크롤은 필요 없음, 휠은 항상 줌으로 씀. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseRightButtonDown="PanZoomScrollViewer_PreviewMouseRightButtonDown"
                                  MouseMove="PanZoomScrollViewer_MouseMove"
                                  PreviewMouseRightButtonUp="PanZoomScrollViewer_PreviewMouseRightButtonUp"
                                  LostMouseCapture="PanZoomScrollViewer_LostMouseCapture"
                                  PreviewMouseWheel="PanZoomScrollViewer_PreviewMouseWheel">
                        <Grid Width="{Binding OriginalDisplayWidth}" Height="{Binding OriginalDisplayHeight}">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/>
                            </Grid.LayoutTransform>
                            <Image Source="{Binding OriginalDisplayBitmap}" Width="{Binding OriginalDisplayWidth}" Height="{Binding OriginalDisplayHeight}"
                                   Stretch="Fill"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StitchSubView" DataType="{x:Type models:ComparePanelState}">
            <Grid>
                <TextBlock Text="스티칭 결과가 없습니다." Foreground="{StaticResource Text2}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding StitchDisplayBitmap, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                <DockPanel Visibility="{Binding StitchDisplayBitmap, Converter={StaticResource TruthyToVisibilityConverter}}">
                    <!-- CM 폴백이 걸린 facade만 정합(rectified) 버전이 있고, 아니면 일반
                         Homography 체인 스티칭 결과가 대신 표시된다. 어느 쪽인지 항상 명시. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="CM 정합 적용됨" FontSize="10.5" Foreground="{StaticResource Accent}"
                                   Visibility="{Binding StitchIsColmapRectified, Converter={StaticResource TruthyToVisibilityConverter}}"/>
                        <TextBlock Text="기본 스티칭 (CM 미적용)" FontSize="10.5" Foreground="{StaticResource Text2}"
                                   Visibility="{Binding StitchIsColmapRectified, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="－"
                                Command="{Binding DataContext.ZoomOutPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding ZoomFactor, StringFormat={}{0:0%}}" Foreground="{StaticResource Text2}"
                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button Content="＋"
                                Command="{Binding DataContext.ZoomInPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Margin="0,0,4,0"/>
                        <Button Content="전체 보기" Margin="0,0,4,0" Click="FitZoomButton_Click"/>
                        <Button Content="원본 크기"
                                Command="{Binding DataContext.ResetZoomPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Click="ResetZoomButton_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="더블클릭하면 전체화면 · 우클릭 드래그로 이동 · 휠로 줌" FontSize="10" Foreground="{StaticResource Text2}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseRightButtonDown="PanZoomScrollViewer_PreviewMouseRightButtonDown"
                                  MouseMove="PanZoomScrollViewer_MouseMove"
                                  PreviewMouseRightButtonUp="PanZoomScrollViewer_PreviewMouseRightButtonUp"
                                  LostMouseCapture="PanZoomScrollViewer_LostMouseCapture"
                                  PreviewMouseWheel="PanZoomScrollViewer_PreviewMouseWheel">
                        <Grid Width="{Binding StitchDisplayWidth}" Height="{Binding StitchDisplayHeight}">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/>
                            </Grid.LayoutTransform>
                            <Image Source="{Binding StitchDisplayBitmap}" Width="{Binding StitchDisplayWidth}" Height="{Binding StitchDisplayHeight}"
                                   Stretch="Fill" Cursor="Hand" MouseLeftButtonDown="StitchImage_MouseLeftButtonDown"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReportSubView" DataType="{x:Type models:ComparePanelState}">
            <Grid>
                <TextBlock Text="보고서가 아직 생성되지 않았습니다." Foreground="{StaticResource Text2}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ReportPageBitmap, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                <DockPanel Visibility="{Binding ReportPageBitmap, Converter={StaticResource TruthyToVisibilityConverter}}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="◀ 이전 페이지" Margin="0,0,6,0"
                                Command="{Binding DataContext.PreviousReportPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <TextBlock Text="{Binding ReportPageLabel}" Foreground="{StaticResource Text2}" FontFamily="Consolas"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="다음 페이지 ▶" Margin="0,0,12,0"
                                Command="{Binding DataContext.NextReportPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="－"
                                Command="{Binding DataContext.ZoomOutPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding ZoomFactor, StringFormat={}{0:0%}}" Foreground="{StaticResource Text2}"
                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button Content="＋"
                                Command="{Binding DataContext.ZoomInPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Margin="0,0,4,0"/>
                        <Button Content="초기화"
                                Command="{Binding DataContext.ResetZoomPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Click="ResetZoomButton_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="기본은 화면에 맞춤 · 우클릭 드래그로 이동 · 휠로 줌" FontSize="10" Foreground="{StaticResource Text2}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <!-- ZoomFactor=1일 때 패널 뷰포트에 딱 맞도록 ReportDisplayWidth/Height를
                         실제 컨테이너 크기 기준으로 계산한다(FitReportPage, 코드비하인드).
                         원본/스티칭의 고정 MaxDisplayDim 방식과 다름. 줌하면 그 기준 크기
                         위로 커지면서 스크롤이 생긴다. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Loaded="ReportScrollViewer_Loaded" SizeChanged="ReportScrollViewer_SizeChanged"
                                  PreviewMouseRightButtonDown="PanZoomScrollViewer_PreviewMouseRightButtonDown"
                                  MouseMove="PanZoomScrollViewer_MouseMove"
                                  PreviewMouseRightButtonUp="PanZoomScrollViewer_PreviewMouseRightButtonUp"
                                  LostMouseCapture="PanZoomScrollViewer_LostMouseCapture"
                                  PreviewMouseWheel="PanZoomScrollViewer_PreviewMouseWheel">
                        <Grid Width="{Binding ReportDisplayWidth}" Height="{Binding ReportDisplayHeight}">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/>
                            </Grid.LayoutTransform>
                            <Image Source="{Binding ReportPageBitmap}" Width="{Binding ReportDisplayWidth}" Height="{Binding ReportDisplayHeight}"
                                   Stretch="Fill"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <!-- === 결과 목록 트리(단지/동/방위) — 분석·스티칭 화면의 FACADES 트리와 같은
             ComplexNode/BuildingNode/SideGroupNode 타입, 같은 FacadeHierarchyStore 분류를
             쓰므로 두 화면의 그룹핑이 항상 일치한다(사용자 요청: 어느 아파트/동인지
             알 수 없던 문제). MainWindow.xaml의 같은 이름 암시적 템플릿과는 이 UserControl
             Resources 범위 안에서만 우선 적용되므로 서로 간섭하지 않는다. 여기 leaf는
             FacadeItemViewModel이 아니라 이 화면 자체의 FacadeSnapshot이라 카드 내용도
             다르게 그린다. 이 목록은 선택만 하고, 실행/분류 변경은 분석·스티칭 화면의 몫. -->
        <DataTemplate DataType="{x:Type vm:ComplexNode}">
            <Expander Style="{StaticResource TreeGroupExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <TextBlock Text="{Binding ComplexName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text}"/>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Children}" Margin="10,2,0,0"/>
            </Expander>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BuildingNode}">
            <Expander Style="{StaticResource TreeGroupExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <TextBlock Text="{Binding BuildingName}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Text}"/>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Children}" Margin="10,2,0,0"/>
            </Expander>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SideGroupNode}">
            <Expander Style="{StaticResource TreeGroupExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <TextBlock Text="{Binding Side}" FontSize="11" Foreground="{StaticResource Text2}"/>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Facades}" Margin="8,0,0,0"/>
            </Expander>
        </DataTemplate>

        <DataTemplate DataType="{x:Type services:FacadeSnapshot}">
            <Border Background="{StaticResource Surface2}" CornerRadius="6" Padding="8,6" Margin="0,2" BorderThickness="1" Cursor="Hand">
                <Border.BorderBrush>
                    <MultiBinding Converter="{StaticResource ReferenceEqualsToBrushConverter}">
                        <Binding/>
                        <Binding Path="DataContext.SelectedFacade" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    </MultiBinding>
                </Border.BorderBrush>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectFacadeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <TextBlock Text="{Binding FacadeId}" FontWeight="Bold" Foreground="{StaticResource Text}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- === 결과 목록 리스트 === -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="결과 목록" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FacadeTree}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- === 비교 패널 2개 / 균열 검토 === -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"
                        Visibility="{Binding SelectedFacade, Converter={StaticResource TruthyToVisibilityConverter}}">
                <Button Command="{Binding ToggleReviewModeCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="균열 검토 모드"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReviewMode}" Value="True">
                                    <Setter Property="Content" Value="◀ 비교 보기로 돌아가기"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

        <Grid Visibility="{Binding IsReviewMode, Converter={StaticResource FalsyToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="2" Text="왼쪽에서 결과를 선택하세요" Foreground="{StaticResource Text2}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding SelectedFacade, Converter={StaticResource FalsyToVisibilityConverter}}"/>

            <!-- panel 1: 원본 | 스티칭 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0" DataContext="{Binding Panel1}"
                    Visibility="{Binding DataContext.SelectedFacade, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TruthyToVisibilityConverter}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="원본" Margin="0,0,6,0"
                                Command="{Binding DataContext.SetPanel1ModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="원본"/>
                        <Button Content="스티칭 결과"
                                Command="{Binding DataContext.SetPanel1ModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="스티칭"/>
                    </StackPanel>
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource OriginalSubView}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mode}" Value="스티칭">
                                        <Setter Property="ContentTemplate" Value="{StaticResource StitchSubView}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DockPanel>
            </Border>

            <!-- panel 2: 스티칭 | 보고서 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,0,0" DataContext="{Binding Panel2}"
                    Visibility="{Binding DataContext.SelectedFacade, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TruthyToVisibilityConverter}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="스티칭 결과" Margin="0,0,6,0"
                                Command="{Binding DataContext.SetPanel2ModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="스티칭"/>
                        <Button Content="보고서(PDF)"
                                Command="{Binding DataContext.SetPanel2ModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="보고서"/>
                    </StackPanel>
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource StitchSubView}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mode}" Value="보고서">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ReportSubView}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- === 균열 검토 패널 === -->
        <Grid Visibility="{Binding IsReviewMode, Converter={StaticResource TruthyToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- 모자이크 + 크랙 오버레이 + 신규 크랙 드로잉 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="10">
                <Grid>
                    <TextBlock Text="스티칭 결과가 없어 검토할 수 없습니다." Foreground="{StaticResource Text2}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ReviewDisplayBitmap, Converter={StaticResource FalsyToVisibilityConverter}}"/>

                    <DockPanel Visibility="{Binding ReviewDisplayBitmap, Converter={StaticResource TruthyToVisibilityConverter}}">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="－" Command="{Binding ZoomOutReviewCommand}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding ReviewZoomFactor, StringFormat={}{0:0%}}" Foreground="{StaticResource Text2}"
                                       FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="＋" Command="{Binding ZoomInReviewCommand}" Margin="0,0,4,0"/>
                            <Button Content="전체 보기" Margin="0,0,4,0" Click="FitZoomButton_Click"/>
                            <Button Content="원본 크기" Command="{Binding ResetZoomReviewCommand}" Margin="0,0,4,0"/>
                            <!-- 스티칭 모자이크에서 구분하기 어려운 크랙을 원본(비왜곡) 사진에서
                                 직접 보기 위한 별도 창. 번호 배지 클릭/목록 선택 시(SelectedReviewItem
                                 변경) 열려 있으면 자동으로 그 크랙의 원본 사진으로 갱신된다, 아래
                                 OpenOriginalViewerButton_Click/SelectedReviewItem 구독 참고. -->
                            <Button Content="원본 보기" Click="OpenOriginalViewerButton_Click"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="드래그로 놓친 균열을 새로 그릴 수 있습니다 · 우클릭 드래그로 이동 · 휠로 줌"
                                   FontSize="10" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                        <ScrollViewer x:Name="ReviewScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      PreviewMouseRightButtonDown="PanZoomScrollViewer_PreviewMouseRightButtonDown"
                                      MouseMove="PanZoomScrollViewer_MouseMove"
                                      PreviewMouseRightButtonUp="PanZoomScrollViewer_PreviewMouseRightButtonUp"
                                      LostMouseCapture="PanZoomScrollViewer_LostMouseCapture"
                                      PreviewMouseWheel="ReviewScrollViewer_PreviewMouseWheel">
                            <Grid Width="{Binding ReviewDisplayWidth}" Height="{Binding ReviewDisplayHeight}">
                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ReviewZoomFactor}" ScaleY="{Binding ReviewZoomFactor}"/>
                                </Grid.LayoutTransform>
                                <Image Source="{Binding ReviewDisplayBitmap}" Width="{Binding ReviewDisplayWidth}" Height="{Binding ReviewDisplayHeight}" Stretch="Fill"/>

                                <!-- 드래그로 신규 크랙 그리기: 코드비하인드 전용 (AiTrainingView의 DrawCanvas와 동일 패턴).
                                     크랙 오버레이(번호 배지 Button 포함)보다 먼저 선언해서 Z-order상 아래에 둔다.
                                     그래야 번호 배지가 클릭을 가로챌 수 있고, 배지/폴리곤이 없는 빈 캔버스 영역은
                                     그대로 이 캔버스까지 클릭이 통과해서 드래그-그리기가 계속 동작한다. -->
                                <Canvas x:Name="ReviewDrawCanvas" Width="{Binding ReviewDisplayWidth}" Height="{Binding ReviewDisplayHeight}"
                                        Background="Transparent" Cursor="Cross"
                                        MouseLeftButtonDown="ReviewDrawCanvas_MouseLeftButtonDown"
                                        MouseMove="ReviewDrawCanvas_MouseMove"
                                        MouseLeftButtonUp="ReviewDrawCanvas_MouseLeftButtonUp"/>

                                <!-- AI 탐지 + 수동 추가 크랙 오버레이. 상태별 색: 대기=빨강, 제외=주황, 수동추가=파랑.
                                     ReviewDrawCanvas보다 뒤에 선언(=위에 렌더링)해야 번호 배지 Button이 클릭을 받는다. -->
                                <ItemsControl ItemsSource="{Binding ReviewItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{Binding ReviewDisplayWidth}" Height="{Binding ReviewDisplayHeight}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:CrackReviewItem}">
                                            <Canvas>
                                                <!-- 제외해도 윤곽선은 또렷하게 남긴다: 회색 가는 점선+투명 채움으로
                                                     지워버리면 "여기 크랙 후보가 있었다"는 사실 자체가 배경 벽면과
                                                     구분이 안 돼서 사라져 보였다(사용자가 스크린샷으로 지적한 문제). -->
                                                <!-- IsHitTestVisible=False: 이 폴리곤 자체는 클릭을 받지 않고 그대로
                                                     아래(ReviewDrawCanvas)로 통과시킨다. 거기서 TryToggleHighlightAt이
                                                     선 위 클릭을 좌표로 직접 판정해 토글한다(확대해서 선을 정확히
                                                     클릭할 수 있을 때 쓰는 보조 경로). 평소에는 아래쪽 번호 배지
                                                     Button이 더 안정적인 주 클릭 타겟. 꺼지면 Fill/Stroke=Transparent
                                                     트리거가 최종 적용돼서 원본 픽셀이 완전히 드러난다. -->
                                                <!-- Fill의 기본값도 반드시 Style.Setter로 줘야 한다. Polygon 요소에
                                                     Fill="..."을 로컬 속성으로 박아두면 WPF 속성 우선순위상 로컬 값이
                                                     항상 Style/Trigger보다 이겨서, 아래 Rejected/Manual/Hidden
                                                     트리거의 Fill Setter가 전부 무시된다(실제 버그였음: "숨김"으로
                                                     바꿔도 색이 안 지워짐, 사용자가 직접 재현해서 지적). -->
                                                <Polygon Points="{Binding CanvasPoints}" StrokeThickness="1.5" IsHitTestVisible="False">
                                                    <Polygon.Style>
                                                        <Style TargetType="Polygon">
                                                            <Setter Property="Stroke" Value="#CCE04F4F"/>
                                                            <Setter Property="Fill" Value="#1AFF0000"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                    <Setter Property="Stroke" Value="#F1C40F"/>
                                                                    <Setter Property="StrokeThickness" Value="2.5"/>
                                                                    <Setter Property="StrokeDashArray" Value="5,3"/>
                                                                    <Setter Property="Fill" Value="#22F1C40F"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Manual">
                                                                    <Setter Property="Stroke" Value="#4C8BF5"/>
                                                                    <Setter Property="Fill" Value="#224C8BF5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsHighlightVisible}" Value="False">
                                                                    <Setter Property="Stroke" Value="Transparent"/>
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Polygon.Style>
                                                </Polygon>
                                                <!-- 번호 배지: 크랙 위에 직접 겹치지 않도록 위/왼쪽으로 살짝 띄워 배치하고,
                                                     ScaleTransform(1/줌)으로 확대해도 항상 같은 화면 크기를 유지한다.
                                                     예전에는 "크랙ID · 상태" 전체 텍스트 라벨이 이미지와 같은
                                                     LayoutTransform을 타고 줌과 함께 커져서, 확대해서 자세히 보려고
                                                     할수록 라벨이 화면을 뒤덮어 정작 크랙 자체가 안 보이는 문제가
                                                     있었다(사용자가 575% 확대 스크린샷으로 지적). 위치(Canvas.Left/Top)는
                                                     그대로 두어서 팬/줌해도 항상 이 크랙 자리에 붙어 있다.
                                                     "원본과 크랙 항목이 별도 레이어처럼 동작하되 한몸처럼 움직인다"는
                                                     요청과 같은 개념. 클릭하면 ToggleCrackHighlightCommand로 토글한다:
                                                     가는 폴리곤 선을 직접 클릭하는 것보다 훨씬 안정적인 클릭 타겟. -->
                                                <Button Canvas.Left="{Binding CanvasLabelX}" Canvas.Top="{Binding CanvasLabelY}"
                                                        Command="{Binding DataContext.ToggleCrackHighlightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding LabelText}" Cursor="Hand"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Button.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform ScaleX="{Binding DataContext.InverseReviewZoomFactor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            ScaleY="{Binding DataContext.InverseReviewZoomFactor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                            <TranslateTransform X="-11" Y="-26"/>
                                                        </TransformGroup>
                                                    </Button.RenderTransform>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" BorderBrush="White">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#E04F4F"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                                <Setter Property="Background" Value="#D9822B"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Manual">
                                                                                <Setter Property="Background" Value="#4C8BF5"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsHighlightVisible}" Value="False">
                                                                                <Setter Property="Background" Value="#993A3A3A"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding DisplayNumber}" Foreground="White" FontSize="10.5" FontWeight="Bold"
                                                                           FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 크랙 목록 + 저장/재생성 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="균열 검토" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ReviewStatusText}" Foreground="{StaticResource Text2}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Text2}" FontSize="10.5" Margin="0,0,0,10"
                               Visibility="{Binding ReviewedBy, Converter={StaticResource TruthyToVisibilityConverter}}">
                        <Run Text="최근 검토: "/><Run Text="{Binding ReviewedBy, Mode=OneWay}"/>
                        <Run Text=" · "/><Run Text="{Binding ReviewedAt, Mode=OneWay}"/>
                    </TextBlock>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="검토 저장" Command="{Binding SaveReviewCommand}" Margin="0,0,0,6"/>
                        <Button Content="최종 보고서 재생성" Command="{Binding RegenerateFinalReportCommand}" FontWeight="Bold"
                                Visibility="{Binding IsRegeneratingReport, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                        <StackPanel Visibility="{Binding IsRegeneratingReport, Converter={StaticResource TruthyToVisibilityConverter}}">
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,0,6"/>
                            <TextBlock Text="최종 보고서 생성 중…" FontSize="11" Foreground="{StaticResource Text2}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding ReviewItems}" SelectedItem="{Binding SelectedReviewItem, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CrackReviewItem}">
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <StackPanel>
                                        <!-- 번호 배지: 캔버스 위 배지와 같은 색/트리거 규칙을 그대로 재사용해서,
                                             캔버스에서 숨긴 크랙을 이 목록에서 같은 번호로 바로 찾을 수 있게 한다
                                             (사용자 요청: 배지를 숨겨도 오른쪽 목록에서 매핑해서 알아볼 수 있어야 함). -->
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="White" Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E04F4F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                <Setter Property="Background" Value="#D9822B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Manual">
                                                                <Setter Property="Background" Value="#4C8BF5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHighlightVisible}" Value="False">
                                                                <Setter Property="Background" Value="#993A3A3A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DisplayNumber}" Foreground="White" FontSize="10" FontWeight="Bold"
                                                           FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding CrackId}" FontWeight="Bold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                            <TextBlock Text="숨김" Foreground="#D9822B" FontSize="10.5" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding IsHighlightVisible, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <TextBlock Foreground="{StaticResource Text2}" FontSize="11">
                                            <Run Text="길이 "/><Run Text="{Binding LengthText, Mode=OneWay}"/>
                                            <Run Text=" · 폭 "/><Run Text="{Binding WidthText, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="{StaticResource Text2}" FontSize="11" Text="{Binding ConfidenceText, StringFormat='신뢰도 {0}'}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Margin="0,0,6,0"
                                                    Command="{Binding DataContext.ToggleCrackRejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding Status, Converter={StaticResource StringNotEqualsToVisibilityConverter}, ConverterParameter=Manual}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="제외"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                <Setter Property="Content" Value="제외 취소"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="삭제 (수동 추가 취소)"
                                                    Command="{Binding DataContext.RemoveManualCrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding Status, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Manual}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        </DockPanel>
    </Grid>
</UserControl>
