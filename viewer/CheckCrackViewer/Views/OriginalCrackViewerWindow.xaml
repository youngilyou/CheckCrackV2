<Window x:Class="CheckCrackViewer.Views.OriginalCrackViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="원본 보기"
        Background="#0B0D0E" WindowStartupLocation="Manual">
    <Grid>
        <Grid x:Name="Viewport" ClipToBounds="True" Background="#0B0D0E"
              SizeChanged="Viewport_SizeChanged"
              MouseWheel="Canvas_MouseWheel"
              MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
              MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
              MouseMove="Canvas_MouseMove">
            <!-- ImageViewerWindow.xaml.cs와 동일한 이유로 RenderTransform 대신
                 Width/Height/Canvas.Left/Top을 매 스텝 직접 설정한다(소프트웨어
                 렌더링에서 ScaleTransform이 이미지 일부만 그리는 문제 회피). -->
            <Canvas x:Name="ImageCanvas" Background="Transparent">
                <Image x:Name="TheImage" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Fill"/>
                <!-- 이 크랙의 bbox_px_in_source 위치를 원본 사진 위에 그대로 표시,
                     "스티칭에서 구분하기 어려운 걸 원본에서 명확히 보기 위함"이 목적이므로,
                     어디를 봐야 하는지 자체를 사각형으로 짚어준다. -->
                <Rectangle x:Name="CrackBboxOverlay" Stroke="#FF4F4F" StrokeThickness="2"
                           IsHitTestVisible="False" Visibility="Collapsed"/>
            </Canvas>
        </Grid>

        <!-- toolbar -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#CC1C2124" CornerRadius="0,0,10,0" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CrackIdText" Foreground="#E7E9E4" FontFamily="Consolas" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="PrevButton" Content="◀ 이전" Click="PrevButton_Click" Margin="0,0,6,0"/>
                <TextBlock x:Name="PositionText" Foreground="#9AA39C" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="NextButton" Content="다음 ▶" Click="NextButton_Click" Margin="0,0,16,0"/>
                <Button x:Name="RecenterButton" Content="원본 크기로 복귀" Click="RecenterButton_Click" Margin="0,0,16,0"/>
                <TextBlock x:Name="FileNameText" Foreground="#E7E9E4" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock x:Name="ZoomText" Foreground="#9AA39C" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock x:Name="HintText" Text="휠: 확대/축소 · 드래그: 이동 · Esc: 닫기" Foreground="#C7CDC8" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 기본값: 아직 크랙을 선택하지 않은 상태. ShowCrack이 호출되면 크랙은 있지만
             source_observations가 비어있는 경우(구버전 facade 등)의 문구로 바뀐다. -->
        <TextBlock x:Name="EmptyStateText" Text="번호 배지를 클릭하거나 목록에서 크랙을 선택하세요"
                   Foreground="#9AA39C" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
