<UserControl x:Class="CheckCrackViewer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CheckCrackViewer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- 이 화면 전용 DataContext는 없음. MainWindow가 여기 두는 다른 탭(원본 AI/결과보기/
         AI 학습)과 달리 설정 화면은 처음부터 MainViewModel 자신의 속성/커맨드(DbHost, 계정
         변경, ActiveJobs, ErrorLogView 등)를 직접 쓰므로, DataContext는 그대로 Window에서
         상속받는다(명시적 바인딩 불필요). -->
    <UserControl.Resources>
        <!-- 이 앱 최초의 TabControl(설정 페이지 계정/연결 · 시스템 상태). 기본 크롬(밝은
             Aero 그라디언트)이 다크 테마와 충돌해서 완전 커스텀 ControlTemplate 필요
             (Expander처럼 브러시만 얹는 걸로는 부족). 이 화면 전용이라 UserControl 범위로
             한정한다 (TabControl을 쓰는 다른 화면이 아직 없음). -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Background="Transparent" Margin="0,0,0,-1"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,16,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="설정" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text4}"
                   Margin="28,28,28,10"/>

        <TabControl Grid.Row="1" Margin="20,0,20,0">
            <TabItem Header="계정/연결" Foreground="{StaticResource Text4}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="32,16,32,28" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48*" MinWidth="500"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="52*" MinWidth="520"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="외부 컴퓨터에서 운용되는 MySQL DB 연결 정보를 입력합니다."
                                   Foreground="{StaticResource Text4}" Margin="0,0,0,20"/>

                        <!-- === 계정: 로그인 계정명/비밀번호 변경 (SQLite users.db, MySQL과 무관) === -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="계정" Style="{StaticResource Kicker}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding LoggedInUsername, StringFormat='로그인: {0}'}" Foreground="{StaticResource Text2}" Margin="0,0,0,14"/>

                                <TextBlock Text="현재 비밀번호 (계정명·비밀번호 변경 공통 확인)" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                <PasswordBox x:Name="CurrentPasswordInput" Padding="8,5" Margin="0,0,0,16"
                                             Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                             PasswordChanged="CurrentPasswordInput_PasswordChanged"/>

                                <TextBlock Text="새 계정명" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,0,0,8"
                                         Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                <Button Content="계정명 변경" Command="{Binding ChangeUsernameCommand}" HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,18"/>

                                <TextBlock Text="새 비밀번호" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                <PasswordBox x:Name="NewPasswordInput" Padding="8,5" Margin="0,0,0,10"
                                             Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                             PasswordChanged="NewPasswordInput_PasswordChanged"/>

                                <TextBlock Text="새 비밀번호 확인" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                <PasswordBox x:Name="ConfirmNewPasswordInput" Padding="8,5" Margin="0,0,0,12"
                                             Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                             PasswordChanged="ConfirmNewPasswordInput_PasswordChanged"/>

                                <Button Content="비밀번호 변경" Command="{Binding ChangePasswordCommand}" HorizontalAlignment="Left" Padding="10,5"/>
                                <TextBlock Text="{Binding AccountStatus}" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- === MySQL 연결: 기존 항목/Binding/Command 모두 유지 === -->
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="MySQL 연결" Style="{StaticResource Kicker}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="DB Host / IP" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,12,10"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DbHost, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,12,10" Padding="8,5" Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="예: 192.168.0.50" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Port" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,12,10"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DbPort, UpdateSourceTrigger=PropertyChanged}"
                                             Width="120" HorizontalAlignment="Left" Margin="0,0,12,10" Padding="8,5"
                                             Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="기본 3306" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Database" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,12,10"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DbName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,12,10" Padding="8,5" Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="User ID" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,12,10"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,12,10" Padding="8,5" Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Password" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,12,10"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DbPassword, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,12,10" Padding="8,5" Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>

                                    <!-- 2026-08-29: 체크박스 2개는 VerticalAlignment이 없어서 기본값(Stretch)으로
                                         남아있었고, TextBox는 Padding="8,5" 때문에 체크박스보다 실제 렌더링
                                         높이가 더 커서 StackPanel 전체 높이가 TextBox 기준으로 늘어남. 그
                                         결과 체크박스 라벨과 TextBox/Timeout 텍스트의 실제 세로 중심이 서로
                                         어긋나 보였음(사용자 스크린샷으로 확인). 이 행의 모든 요소에
                                         VerticalAlignment="Center"를 명시해서 각 컨트롤 타입의 서로 다른
                                         기본 정렬에 기대지 않고 항상 같은 가로선에 놓이게 함. -->
                                    <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <CheckBox Content="SSL 사용" IsChecked="{Binding DbUseSsl}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                        <CheckBox Content="비밀번호 저장" IsChecked="{Binding DbSavePassword}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                        <TextBlock Text="Timeout" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding DbTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="50" VerticalAlignment="Center"
                                                 Padding="8,5" Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                        <TextBlock Text="초" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="연결 테스트" Command="{Binding TestDbConnectionCommand}" Margin="0,0,8,0"/>
                                    <Button Content="저장" Command="{Binding SaveDbSettingsCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- === 환경 설정 (읽기 전용) — AI 모델 경로 + 파일 저장소 상태 통합 (2026-08-29) ===
                             기존에 "상태"(DB 연결 테스트 결과, MySQL 연결 카드 바로 옆에 이미
                             있어서 중복), "AI 모델 경로", "환경 설정" 3개 카드로 나뉘어 있던 것을
                             하나로 합침. "상태" 카드는 삭제(운영자 요청, MySQL 연결 카드 자체에도
                             결과가 안 보이는 게 아니라, 별도 카드로 반복 노출할 필요가 없다는 판단).
                             "파일 저장소 상태"는 원래 "시스템 상태" 탭에 있었는데 여기로 이동함.
                             셋 다 "운영자가 바꿀 수 없는, 현재 환경을 그대로 보여주는 읽기 전용
                             정보"라는 점에서 성격이 같음.
                             2026-08-28: "Python 실행 파일"(로컬 PC의 python.exe 절대경로, 사용자명
                             포함) 표시는 제거: 화면에 노출할 필요 없는 로컬 환경 정보. -->
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="환경 설정" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>

                                <TextBlock Text="RootPath" Foreground="{StaticResource Text2}" FontSize="11"/>
                                <TextBlock Text="{Binding RootPath}" Foreground="{StaticResource Text}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <TextBlock Text="AI 모델 경로" Foreground="{StaticResource Text2}" FontSize="11"/>
                                <TextBlock Text="config/pipeline.yaml의 crack.model 값입니다 (읽기 전용 — 크랙 검사가 실제로 쓰는 모델은 항상 이 YAML 기본값)."
                                           Foreground="{StaticResource Text2}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                <TextBlock Text="{Binding AiModelPath}" Foreground="{StaticResource Text}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <TextBlock Text="파일 저장소 상태" Foreground="{StaticResource Text2}" FontSize="11"/>
                                <TextBlock Text="{Binding StorageStatusText}" Foreground="{StaticResource Text}" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="시스템 상태" Foreground="{StaticResource Text4}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="32,16,32,28" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="500"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*" MinWidth="500"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="애플리케이션 내부에서 관측 가능한 실제 신호만 표시합니다 (촬영/드론 상태는 이 Viewer가 관측하지 않음)."
                                   Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <!-- 2026-08-29: "DB 연결 상태"(계정/연결 탭 MySQL 연결 카드와 중복)와
                             "파일 저장소 상태"(계정/연결 탭 "환경 설정" 카드로 통합됨)를 여기서
                             삭제함(운영자 요청). 처리 Job/오류 로그가 원래 Row 2였던 것을 Row 1로
                             당김. -->

                        <!-- 처리 Job -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="처리 Job" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>
                                <TextBlock Text="현재 처리 중인 작업이 없습니다." Foreground="{StaticResource Text2}" FontSize="12"
                                           Visibility="{Binding ActiveJobs.Count, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{Binding ActiveJobs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface2}" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FacadeId}" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource Text}" Width="110"/>
                                                    <TextBlock Text="스티칭 중" Foreground="{StaticResource Accent}" FontSize="11.5"
                                                               Visibility="{Binding IsRunning, Converter={StaticResource TruthyToVisibilityConverter}}"/>
                                                    <TextBlock Text="크랙 탐지 중" Foreground="{StaticResource Accent}" FontSize="11.5"
                                                               Visibility="{Binding IsDetectingCracks, Converter={StaticResource TruthyToVisibilityConverter}}"/>
                                                    <TextBlock Text="보고서 생성 중" Foreground="{StaticResource Accent}" FontSize="11.5"
                                                               Visibility="{Binding IsGeneratingReport, Converter={StaticResource TruthyToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 오류/로그 -->
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="오류/로그 (WARNING/ERROR만)" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>
                                <ListBox ItemsSource="{Binding ErrorLogView}" Background="Transparent" BorderThickness="0"
                                         ItemTemplate="{StaticResource LogEntryTemplate}"
                                         MaxHeight="360" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <!-- === 원격 분석 연동: CrackVisionDB(PostgreSQL, MngData backend_core)/SFTP 접속
                 정보 + 수동 다운로드. MySQL 연결(계정/연결 탭)과 완전히 별개: 저 카드의
                 DbHost/DbUser 등과 여기 CrackVisionPostgresHost/SftpHost 등은 서로 다른 설정
                 파일(각각 db_settings.json / crackvision_db_settings.json)에 저장됨. 자동
                 (원격 명령) 경로는 SFTP 정보만 사용하고 이 화면과 무관하게 동작한다:
                 archive_id/company/building/zip_remote_path가 이미 AnalysisAssignment에
                 담겨 오기 때문. -->
            <TabItem Header="원격 분석 연동" Foreground="{StaticResource Text4}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="32,16,32,28" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48*" MinWidth="480"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="52*" MinWidth="480"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="FacadePreviewer의 분석 실행 명령(원격, 자동)과 관리자가 직접 고르는 수동 다운로드가 함께 쓰는 접속 정보입니다."
                                   Foreground="{StaticResource Text4}" Margin="0,0,0,20" TextWrapping="Wrap"/>

                        <!-- CrackVisionDB (PostgreSQL) -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="CrackVisionDB (PostgreSQL)" Style="{StaticResource Kicker}" Margin="0,0,0,10"/>
                                <TextBlock Text="수동 다운로드 목록 조회에만 사용됩니다 (자동 경로는 DB에 접속하지 않음)."
                                           Foreground="{StaticResource Text2}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Host" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionPostgresHost, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionPostgresPort, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Database" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionPostgresDatabase, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="User" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionPostgresUser, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Password" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <PasswordBox x:Name="CrackVisionPostgresPasswordInput" Padding="8,5"
                                                     Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                                     PasswordChanged="CrackVisionPostgresPasswordInput_PasswordChanged"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 점검/실행 절차: 2026-08-27 mngdata_backend OOM 종료 + Postgres 원격 접속
                                     차단 복구 작업 중 반복 확인한 순서 그대로 (전체 배경은
                                     MngData/CLAUDE.local.md "mngdata_backend OOM 종료 + CrackVisionDB
                                     원격 접속 막힘 복구" 참고). -->
                                <Border Background="{StaticResource Surface2}" CornerRadius="6" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="점검 · 실행 절차" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Foreground="{StaticResource Text2}" FontSize="10.5" TextWrapping="Wrap" LineHeight="16">
                                            1) 서버에서 mngdata_backend 상태 확인 (curl http://서버IP:18080/api/system/health)<LineBreak/>
                                            2) 죽어있으면: backend_core/scripts/start.sh<LineBreak/>
                                            3) DB 접속이 막혀있으면: sudo scripts/allow_postgres_remote_access.sh &lt;이 PC의 IP&gt;<LineBreak/>
                                            4) 위 값 입력 후 저장 → 아래 "목록 새로고침"으로 연결 테스트
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SFTP -->
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="SFTP (zip 다운로드)" Style="{StaticResource Kicker}" Margin="0,0,0,10"/>
                                <TextBlock Text="자동/수동 경로 둘 다 이 정보로 zip 파일을 내려받습니다. Password 방식만 지원하므로 반드시 입력해야 합니다."
                                           Foreground="{StaticResource Text2}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Host" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionSftpHost, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionSftpPort, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="User" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionSftpUser, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password (필수)" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <PasswordBox x:Name="CrackVisionSftpPasswordInput" Padding="8,5"
                                                     Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                                     PasswordChanged="CrackVisionSftpPasswordInput_PasswordChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Worker ID (비워두면 컴퓨터 이름 사용)" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionWorkerId, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="저장" Command="{Binding SaveCrackVisionSettingsCommand}" Margin="0,0,8,0" Padding="10,5"/>
                            <TextBlock Text="{Binding CrackVisionSettingsStatus}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 수동 다운로드 -->
                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardBorder}">
                            <!-- 2026-08-29: 헤더 Grid와 각 행 Grid(ItemsControl 템플릿 안, 별개
                                 인스턴스)가 항상 정확히 같은 컬럼 폭을 갖도록 IsSharedSizeScope
                                 사용. 고정 픽셀 폭을 추측해서 넣었던 이전 시도(예: 원본=110)가
                                 실제 "다운로드+등록" 버튼 크기보다 좁아서 여전히 어긋났음(사용자
                                 스크린샷으로 재확인). 폭을 추측하는 대신, 원본/스티칭 결과/보고서
                                 3개 컬럼만 Auto+SharedSizeGroup으로 바꿔서 WPF가 헤더와 모든 행을
                                 통틀어 실제 렌더링된 내용 중 가장 넓은 것에 맞춰 자동으로 폭을
                                 맞추게 함(폰트/DPI가 달라져도 항상 정확히 맞음). 나머지 컬럼(회사/
                                 고객ID/동/이미지수/생성시각/진행상태)은 TextTrimming으로 긴 값을
                                 잘라내야 해서 그대로 고정 폭 유지함. Auto로 바꾸면 트리밍이 아예
                                 작동하지 않게 됨. -->
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="수동 다운로드 (관리자가 직접 선택)" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="목록 새로고침" Command="{Binding RefreshRemoteArchivesCommand}" Padding="8,4"/>
                                </Grid>
                                <TextBlock Text="다운로드+압축해제+왼쪽 목록 등록까지만 자동으로 하고, 분석 실행은 직접 하셔야 합니다 (폴더를 직접 추가했을 때와 동일)."
                                           Foreground="{StaticResource Text2}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- 저장 위치: 이전엔 앱 프로젝트 루트 밑에 고정이었는데, 운용자가 직접
                                     고를 수 있어야 한다는 요청(2026-08-27)으로 편집 가능하게 변경.
                                     기본값은 CrackVisionDbSettingsStore의 DownloadFolder(C:\temp). -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="저장 위치 (아래에 zips/, extracted/ 하위 폴더가 생성됩니다)" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionDownloadFolder, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="찾아보기..." Command="{Binding BrowseCrackVisionDownloadFolderCommand}"
                                            Padding="10,5" VerticalAlignment="Bottom"/>
                                </Grid>
                                <!-- 헤더 행: 아래 ItemsControl의 각 행과 정확히 같은 컬럼 폭
                                     (마지막 3개는 SharedSizeGroup으로 동기화, 위 StackPanel의
                                     IsSharedSizeScope 주석 참고). -->
                                <Grid Margin="10,0,10,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ColOriginal"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ColStitching"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ColReport"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Archive ID" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="회사" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="고객 ID" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="동" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="이미지 수" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="생성 시각" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="진행 상태" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="7" Text="원본" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="8" Text="스티칭 결과" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="9" Text="보고서" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding RemoteArchives}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface2}" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColOriginal"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColStitching"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColReport"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding ArchiveId}" FontFamily="Consolas" Foreground="{StaticResource Text}" TextAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Company}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding ContractId}" Foreground="{StaticResource Text2}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Building}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding ImageCount}" Foreground="{StaticResource Text2}" TextAlignment="Center"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding CreatedAt}" Foreground="{StaticResource Text2}" FontSize="11" TextAlignment="Center"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding DisplayStatus}" Foreground="{StaticResource Accent}" FontSize="11"
                                                                   TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="7" Content="다운로드+등록" IsEnabled="{Binding IsNotBusy}"
                                                                Command="{Binding DataContext.DownloadAndRegisterArchiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" Padding="8,4"/>
                                                        <!-- 단일 방향(대다수 케이스)일 때만: archive의 "가장 최근" 결과를 바로 다운로드.
                                                             방향이 여러 개면 아래 facade별 목록으로 대체(HasMultipleFacadeResults).
                                                             2026-08-29: 실제로 겪은 버그. 기존엔 IsEnabled만 HasStitchingResult/
                                                             HasReport로 걸려있어서, 검토가 아직 안 끝난(결과 파일 자체가 없는)
                                                             archive에도 버튼이 계속 "보이기만" 하고 비활성화된 채로 남아있었음.
                                                             운영자가 "검토 완료된 것만 버튼이 표시돼야 한다"고 명시적으로 요청함.
                                                             이제 결과가 실제로 존재할 때만(HasStitchingResult/HasReport) 버튼
                                                             자체가 나타나고, IsEnabled는 그중에서도 다운로드 진행 중(IsBusy)일 때만
                                                             잠깐 비활성화하는 별개의 역할로 남겨둠. -->
                                                        <Button Grid.Column="8" Content="스티칭 결과" Margin="6,0,0,0" Padding="8,4"
                                                                Visibility="{Binding ShowSingleStitchingResult, Converter={StaticResource TruthyToVisibilityConverter}}"
                                                                IsEnabled="{Binding CanDownloadStitchingResult}"
                                                                Command="{Binding DataContext.DownloadStitchingResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="9" Content="보고서" Margin="6,0,0,0" Padding="8,4"
                                                                Visibility="{Binding ShowSingleReport, Converter={StaticResource TruthyToVisibilityConverter}}"
                                                                IsEnabled="{Binding CanDownloadReport}"
                                                                Command="{Binding DataContext.DownloadReportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>

                                                    <!-- 방향(면)이 여러 개인 archive: 면마다 결과가 따로 있으므로(facade_analysis_results,
                                                         2026-08-29) 면별로 별도 다운로드 버튼을 보여준다: 위 단일 버튼 하나로는
                                                         어느 면 결과인지 알 수 없고, 예전엔 가장 나중에 끝난 면 것으로 덮어써져서
                                                         나머지 면 결과를 아예 받을 방법이 없었음. -->
                                                    <ItemsControl ItemsSource="{Binding FacadeResults}" Margin="0,6,0,0"
                                                                  Visibility="{Binding HasMultipleFacadeResults, Converter={StaticResource TruthyToVisibilityConverter}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="76,2,0,0">
                                                                    <TextBlock Text="{Binding FacadeId}" Foreground="{StaticResource Text2}" FontSize="11"
                                                                               Width="90" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Text2}" FontSize="10.5"
                                                                               Width="80" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    <Button Content="스티칭 결과" Padding="7,3" FontSize="10.5" Margin="0,0,4,0"
                                                                            Visibility="{Binding StitchingZipPath, Converter={StaticResource TruthyToVisibilityConverter}}"
                                                                            IsEnabled="{Binding StitchingZipPath, Converter={StaticResource TruthyToBoolConverter}}"
                                                                            Command="{Binding DataContext.DownloadFacadeStitchingResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                        <Button.CommandParameter>
                                                                            <MultiBinding Converter="{StaticResource RowAndFacadeToRequestConverter}">
                                                                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                                <Binding/>
                                                                            </MultiBinding>
                                                                        </Button.CommandParameter>
                                                                    </Button>
                                                                    <Button Content="보고서" Padding="7,3" FontSize="10.5"
                                                                            Visibility="{Binding ReportPath, Converter={StaticResource TruthyToVisibilityConverter}}"
                                                                            IsEnabled="{Binding ReportPath, Converter={StaticResource TruthyToBoolConverter}}"
                                                                            Command="{Binding DataContext.DownloadFacadeReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                        <Button.CommandParameter>
                                                                            <MultiBinding Converter="{StaticResource RowAndFacadeToRequestConverter}">
                                                                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                                <Binding/>
                                                                            </MultiBinding>
                                                                        </Button.CommandParameter>
                                                                    </Button>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
