<UserControl x:Class="CheckCrackViewer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CheckCrackViewer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- 이 화면 전용 DataContext는 없음. MainWindow가 여기 두는 다른 탭(원본 AI/결과보기/
         AI 학습)과 달리 설정 화면은 처음부터 MainViewModel 자신의 속성/커맨드(DbHost, 계정
         변경, ActiveJobs, ErrorLogView 등)를 직접 쓰므로, DataContext는 그대로 Window에서
         상속받는다(명시적 바인딩 불필요). -->
    <UserControl.Resources>
        <!-- 이 앱 최초의 TabControl(설정 페이지 계정/연결 · 시스템 상태). 기본 크롬(밝은
             Aero 그라디언트)이 다크 테마와 충돌해서 완전 커스텀 ControlTemplate 필요
             (Expander처럼 브러시만 얹는 걸로는 부족). 이 화면 전용이라 UserControl 범위로
             한정한다 (TabControl을 쓰는 다른 화면이 아직 없음). -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Background="Transparent" Margin="0,0,0,-1"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,16,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="설정" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text4}"
                   Margin="28,28,28,10"/>

        <TabControl Grid.Row="1" Margin="20,0,20,0">
            <TabItem Header="계정/연결" Foreground="{StaticResource Text4}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="32,16,32,28" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48*" MinWidth="500"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="52*" MinWidth="520"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="외부 컴퓨터에서 운용되는 MySQL DB 연결 정보를 입력합니다."
                                   Foreground="{StaticResource Text4}" Margin="0,0,0,20"/>

                        <!-- === 계정: 로그인 계정명/비밀번호 변경 (SQLite users.db, MySQL과 무관) === -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="계정" Style="{StaticResource Kicker}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding LoggedInUsername, StringFormat='로그인: {0}'}" Foreground="{StaticResource Text2}" Margin="0,0,0,14"/>

                                <TextBlock Text="현재 비밀번호 (계정명·비밀번호 변경 공통 확인)" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                <PasswordBox x:Name="CurrentPasswordInput" Padding="8,5" Margin="0,0,0,16"
                                             Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                             PasswordChanged="CurrentPasswordInput_PasswordChanged"/>

                                <TextBlock Text="새 계정명" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,0,0,8"
                                         Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                <Button Content="계정명 변경" Command="{Binding ChangeUsernameCommand}" HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,18"/>

                                <TextBlock Text="새 비밀번호" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                <PasswordBox x:Name="NewPasswordInput" Padding="8,5" Margin="0,0,0,10"
                                             Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                             PasswordChanged="NewPasswordInput_PasswordChanged"/>

                                <TextBlock Text="새 비밀번호 확인" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                <PasswordBox x:Name="ConfirmNewPasswordInput" Padding="8,5" Margin="0,0,0,12"
                                             Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                             PasswordChanged="ConfirmNewPasswordInput_PasswordChanged"/>

                                <Button Content="비밀번호 변경" Command="{Binding ChangePasswordCommand}" HorizontalAlignment="Left" Padding="10,5"/>
                                <TextBlock Text="{Binding AccountStatus}" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- === MySQL 연결: 기존 항목/Binding/Command 모두 유지 === -->
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="MySQL 연결" Style="{StaticResource Kicker}" Margin="0,0,0,14"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="DB Host / IP" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,12,10"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DbHost, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,12,10" Padding="8,5" Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="예: 192.168.0.50" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Port" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,12,10"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DbPort, UpdateSourceTrigger=PropertyChanged}"
                                             Width="120" HorizontalAlignment="Left" Margin="0,0,12,10" Padding="8,5"
                                             Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="기본 3306" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Database" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,12,10"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DbName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,12,10" Padding="8,5" Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="User ID" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,12,10"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,12,10" Padding="8,5" Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Password" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,12,10"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DbPassword, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,12,10" Padding="8,5" Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>

                                    <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <CheckBox Content="SSL 사용" IsChecked="{Binding DbUseSsl}" Margin="0,0,18,0"/>
                                        <CheckBox Content="비밀번호 저장" IsChecked="{Binding DbSavePassword}" Margin="0,0,18,0"/>
                                        <TextBlock Text="Timeout" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding DbTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                                 Padding="8,5" Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                        <TextBlock Text="초" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="연결 테스트" Command="{Binding TestDbConnectionCommand}" Margin="0,0,8,0"/>
                                    <Button Content="저장" Command="{Binding SaveDbSettingsCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 상태 -->
                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="상태" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding DbSettingsStatus}" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                <TextBlock Text="현재 테스트는 DB 서버 IP/Port 응답 확인 단계입니다. 고객정보, 의뢰 아파트 정보, 이미지 목록 조회는 DB 테이블 구조 확정 후 연결합니다."
                                           Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- === NEW: AI 모델 경로 (읽기 전용, config/pipeline.yaml에서 읽음) === -->
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="AI 모델 경로" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>
                                <TextBlock Text="config/pipeline.yaml의 crack.model 값입니다 (읽기 전용 — 크랙 검사가 실제로 쓰는 모델은 항상 이 YAML 기본값)."
                                           Foreground="{StaticResource Text2}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding AiModelPath}" Foreground="{StaticResource Text}" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- === NEW: 환경 설정 (읽기 전용) === -->
                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="환경 설정" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>
                                    <TextBlock Text="RootPath" Foreground="{StaticResource Text2}" FontSize="11"/>
                                    <TextBlock Text="{Binding RootPath}" Foreground="{StaticResource Text}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,26,0,0">
                                    <TextBlock Text="Python 실행 파일" Foreground="{StaticResource Text2}" FontSize="11"/>
                                    <TextBlock Text="{Binding PythonExePath}" Foreground="{StaticResource Text}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="시스템 상태" Foreground="{StaticResource Text4}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="32,16,32,28" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="500"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*" MinWidth="500"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="애플리케이션 내부에서 관측 가능한 실제 신호만 표시합니다 (촬영/드론 상태는 이 Viewer가 관측하지 않음)."
                                   Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <!-- DB 연결 상태 -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="DB 연결 상태" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>
                                <TextBlock Text="최근 연결 테스트 결과 (계정/연결 탭의 '연결 테스트' 버튼으로 갱신)"
                                           Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding DbSettingsStatus}" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 파일 저장소 상태 -->
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="파일 저장소 상태" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding StorageStatusText}" Foreground="{StaticResource Text}" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 처리 Job -->
                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="처리 Job" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>
                                <TextBlock Text="현재 처리 중인 작업이 없습니다." Foreground="{StaticResource Text2}" FontSize="12"
                                           Visibility="{Binding ActiveJobs.Count, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{Binding ActiveJobs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface2}" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FacadeId}" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource Text}" Width="110"/>
                                                    <TextBlock Text="스티칭 중" Foreground="{StaticResource Accent}" FontSize="11.5"
                                                               Visibility="{Binding IsRunning, Converter={StaticResource TruthyToVisibilityConverter}}"/>
                                                    <TextBlock Text="크랙 탐지 중" Foreground="{StaticResource Accent}" FontSize="11.5"
                                                               Visibility="{Binding IsDetectingCracks, Converter={StaticResource TruthyToVisibilityConverter}}"/>
                                                    <TextBlock Text="보고서 생성 중" Foreground="{StaticResource Accent}" FontSize="11.5"
                                                               Visibility="{Binding IsGeneratingReport, Converter={StaticResource TruthyToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 오류/로그 -->
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="오류/로그 (WARNING/ERROR만)" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>
                                <ListBox ItemsSource="{Binding ErrorLogView}" Background="Transparent" BorderThickness="0"
                                         ItemTemplate="{StaticResource LogEntryTemplate}"
                                         MaxHeight="360" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <!-- === 원격 분석 연동: CrackVisionDB(PostgreSQL, MngData backend_core)/SFTP 접속
                 정보 + 수동 다운로드. MySQL 연결(계정/연결 탭)과 완전히 별개: 저 카드의
                 DbHost/DbUser 등과 여기 CrackVisionPostgresHost/SftpHost 등은 서로 다른 설정
                 파일(각각 db_settings.json / crackvision_db_settings.json)에 저장됨. 자동
                 (원격 명령) 경로는 SFTP 정보만 사용하고 이 화면과 무관하게 동작한다:
                 archive_id/company/building/zip_remote_path가 이미 AnalysisAssignment에
                 담겨 오기 때문. -->
            <TabItem Header="원격 분석 연동" Foreground="{StaticResource Text4}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="32,16,32,28" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48*" MinWidth="480"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="52*" MinWidth="480"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="FacadePreviewer의 분석 실행 명령(원격, 자동)과 관리자가 직접 고르는 수동 다운로드가 함께 쓰는 접속 정보입니다."
                                   Foreground="{StaticResource Text4}" Margin="0,0,0,20" TextWrapping="Wrap"/>

                        <!-- CrackVisionDB (PostgreSQL) -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="CrackVisionDB (PostgreSQL)" Style="{StaticResource Kicker}" Margin="0,0,0,10"/>
                                <TextBlock Text="수동 다운로드 목록 조회에만 사용됩니다 (자동 경로는 DB에 접속하지 않음)."
                                           Foreground="{StaticResource Text2}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Host" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionPostgresHost, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionPostgresPort, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Database" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionPostgresDatabase, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="User" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionPostgresUser, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Password" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionPostgresPassword, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 점검/실행 절차: 2026-08-27 mngdata_backend OOM 종료 + Postgres 원격 접속
                                     차단 복구 작업 중 반복 확인한 순서 그대로 (전체 배경은
                                     MngData/CLAUDE.local.md "mngdata_backend OOM 종료 + CrackVisionDB
                                     원격 접속 막힘 복구" 참고). -->
                                <Border Background="{StaticResource Surface2}" CornerRadius="6" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="점검 · 실행 절차" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Foreground="{StaticResource Text2}" FontSize="10.5" TextWrapping="Wrap" LineHeight="16">
                                            1) 서버에서 mngdata_backend 상태 확인 (curl http://서버IP:18080/api/system/health)<LineBreak/>
                                            2) 죽어있으면: backend_core/scripts/start.sh<LineBreak/>
                                            3) DB 접속이 막혀있으면: sudo scripts/allow_postgres_remote_access.sh &lt;이 PC의 IP&gt;<LineBreak/>
                                            4) 위 값 입력 후 저장 → 아래 "목록 새로고침"으로 연결 테스트
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SFTP -->
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="SFTP (zip 다운로드)" Style="{StaticResource Kicker}" Margin="0,0,0,10"/>
                                <TextBlock Text="자동/수동 경로 둘 다 이 정보로 zip 파일을 내려받습니다. 개인키를 쓰려면 Private Key Path만 입력(비밀번호는 비워둠)."
                                           Foreground="{StaticResource Text2}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Host" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionSftpHost, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionSftpPort, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="User" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionSftpUser, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password (선택)" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionSftpPassword, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Private Key Path (선택)" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionSftpPrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Worker ID (비워두면 컴퓨터 이름 사용)" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CrackVisionWorkerId, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="저장" Command="{Binding SaveCrackVisionSettingsCommand}" Margin="0,0,8,0" Padding="10,5"/>
                            <TextBlock Text="{Binding CrackVisionSettingsStatus}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 수동 다운로드 -->
                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="수동 다운로드 (관리자가 직접 선택)" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="목록 새로고침" Command="{Binding RefreshRemoteArchivesCommand}" Padding="8,4"/>
                                </Grid>
                                <TextBlock Text="다운로드+압축해제+왼쪽 목록 등록까지만 자동으로 하고, 분석 실행은 직접 하셔야 합니다 (폴더를 직접 추가했을 때와 동일)."
                                           Foreground="{StaticResource Text2}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding RemoteArchives}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface2}" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ArchiveId}" FontFamily="Consolas" Foreground="{StaticResource Text}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Company}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Building}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding ImageCount}" Foreground="{StaticResource Text2}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding CreatedAt}" Foreground="{StaticResource Text2}" FontSize="11"/>
                                                    <TextBlock Grid.Column="5"/>
                                                    <Button Grid.Column="6" Content="다운로드+등록"
                                                            Command="{Binding DataContext.DownloadAndRegisterArchiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Padding="8,4"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
