<Window x:Class="CheckCrackViewer.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CheckCrackViewer.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SmartCrack 로그인" WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
    <Window.Resources>
        <!-- "유리" 입력창: 배경 사진 위에서도 또렷하도록 반투명 흰색 배경 + 옅은 테두리.
             기본 TextBox/PasswordBox 크롬(포커스 시 파란 테두리 등)은 배경 사진과
             어울리지 않아 Border+ScrollViewer로 완전히 새 템플릿을 준다. -->
        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 배경: 드론이 야간에 외벽을 스캔하는 사진 (src/report/assets/main_illustration.png,
             PDF 표지와 같은 이미지를 로그인 화면에도 재사용). UniformToFill + ClipToBounds로
             창 크기/비율이 달라져도 잘리기만 하고 찌그러지지 않는다. -->
        <Image Source="/Assets/login_background.png" Stretch="UniformToFill" ClipToBounds="True"/>

        <!-- 오른쪽 로그인 패널이 사진과 잘 구분되도록 우측을 어둡게 그라데이션. -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00000000" Offset="0.5"/>
                    <GradientStop Color="#99080B0E" Offset="0.72"/>
                    <GradientStop Color="#CC080B0E" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="460" Margin="0,0,0,0"
                Background="#B310151A" BorderBrush="#33FFFFFF" BorderThickness="1,0,0,0">
            <StackPanel VerticalAlignment="Center" Margin="56,40">
                <TextBlock Text="AI Drone Building" FontFamily="Bahnschrift SemiBold" FontSize="26" Foreground="White"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock FontFamily="Bahnschrift SemiBold" FontSize="26" Margin="0,0,0,10"
                           HorizontalAlignment="Center" TextAlignment="Center">
                    <Run Text="Inspection " Foreground="White"/><Run Text="Service" Foreground="{StaticResource Accent}"/>
                </TextBlock>
                <TextBlock Margin="0,0,0,34" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12">
                    <Run Text="SmartCrack" Foreground="{StaticResource Accent}" FontWeight="Bold"/><Run Text=" · 드론 외벽 균열 검사 시스템" Foreground="#B9C2C7"/>
                </TextBlock>

                <TextBlock Text="아이디" Foreground="#B9C2C7" FontSize="11" Margin="0,0,0,6"/>
                <TextBox Style="{StaticResource GlassTextBox}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <TextBlock Text="비밀번호" Foreground="#B9C2C7" FontSize="11" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource GlassPasswordBox}" Margin="0,0,0,16"
                             PasswordChanged="PasswordInput_PasswordChanged" KeyDown="PasswordInput_KeyDown"/>

                <CheckBox Content="로그인 정보 저장" Foreground="#B9C2C7" IsChecked="{Binding RememberLogin}" Margin="0,0,0,24"/>

                <Button Content="LOGIN" Command="{Binding LoginCommand}" IsDefault="True"
                        Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}"
                        FontFamily="Bahnschrift SemiBold" FontSize="13.5" Padding="10,13"/>

                <TextBlock Text="{Binding StatusText}" Foreground="#FF9E7A" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,16,0,0"
                           Visibility="{Binding StatusText, Converter={StaticResource TruthyToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
