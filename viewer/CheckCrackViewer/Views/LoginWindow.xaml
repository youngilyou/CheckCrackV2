<Window x:Class="CheckCrackViewer.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CheckCrackViewer.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SmartCrack 로그인" WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
    <Window.Resources>
        <!-- 이 로그인 화면 전용 브랜드 블루, 앱 나머지 화면의 Accent(주황)와는
             별개로, SMARTCRACK 로고/버튼 색은 마케팅 자료(main_illustration2.png와
             같이 쓰이는 로그인 목업)의 파란색을 그대로 맞춘다. -->
        <SolidColorBrush x:Key="LoginBlue" Color="#3B7DF2"/>
        <SolidColorBrush x:Key="LoginBlueDark" Color="#2F63C7"/>

        <!-- 2026-08-28: "전체 이미지가 너무 어두워" 피드백으로 다크 테마(#0A0E12)에서
             밝은 아쿠아 블루 테마로 전환: main_illustration2.png 사진 자체는 그대로,
             왼쪽 패널/입력창/텍스트 색만 밝게 바꾼다. -->
        <SolidColorBrush x:Key="LoginPageBg" Color="#EAF3FB"/>
        <SolidColorBrush x:Key="LoginTextDark" Color="#17222C"/>
        <SolidColorBrush x:Key="LoginTextMuted" Color="#5B6B78"/>
        <SolidColorBrush x:Key="LoginErrorText" Color="#E3543A"/>

        <!-- 밝은 배경 위 입력창: 흰색 캡슐 + 아이콘 프리픽스. -->
        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource LoginTextDark}"/>
            <Setter Property="CaretBrush" Value="{StaticResource LoginTextDark}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource LoginTextDark}"/>
            <Setter Property="CaretBrush" Value="{StaticResource LoginTextDark}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 입력창을 감싸는 흰색 캡슐, 아이콘 + TextBox/PasswordBox를 한 줄에. -->
        <Style x:Key="InputCapsule" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E6F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="FooterLink" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LoginTextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource LoginPageBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 로그인 패널 (짙은 남색 단색 배경) -->
        <Grid Grid.Column="0" Margin="64,48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 로고: 육각형 + S + SMARTCRACK PREVIEWER + V2 배지 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
                <Grid Width="44" Height="44" Margin="0,0,14,0">
                    <Polygon Points="22,1 41,11.5 41,32.5 22,43 3,32.5 3,11.5" Fill="{StaticResource LoginBlue}"/>
                    <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SMARTCRACK" Foreground="{StaticResource LoginTextDark}" FontWeight="Bold" FontSize="21"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="크랙 분석 시스템" Foreground="{StaticResource LoginTextMuted}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Border Background="{StaticResource LoginBlue}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="V2" Foreground="White" FontWeight="Bold" FontSize="10.5"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 중앙: 태그라인 + 입력 폼 -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock FontSize="24" FontWeight="Bold" Margin="0,0,0,8">
                    <Run Text="AI로 더 정확하게, " Foreground="{StaticResource LoginTextDark}"/><Run Text="안전하게" Foreground="{StaticResource LoginBlue}"/>
                </TextBlock>
                <TextBlock Text="Drone AI Building Inspection Solution" Foreground="{StaticResource LoginTextMuted}" FontSize="13" Margin="0,0,0,40"/>

                <Border Style="{StaticResource InputCapsule}" Margin="0,0,0,14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource LoginTextMuted}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Left" Text="아이디" Foreground="{StaticResource LoginTextMuted}" FontSize="13.5"
                                   VerticalAlignment="Center" Margin="0,0,0,0"
                                   Visibility="{Binding Username, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                        <TextBox Style="{StaticResource GlassTextBox}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource InputCapsule}" Margin="0,0,0,20">
                    <Grid>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource LoginTextMuted}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="PasswordInput" Style="{StaticResource GlassPasswordBox}"
                                         PasswordChanged="PasswordInput_PasswordChanged" KeyDown="PasswordInput_KeyDown"/>
                        </DockPanel>
                        <!-- PasswordBox has no bindable Password DependencyProperty, so the
                             placeholder's visibility is toggled from code-behind
                             (PasswordInput_PasswordChanged) instead of a XAML binding. -->
                        <TextBlock x:Name="PasswordPlaceholder" Text="비밀번호" Foreground="{StaticResource LoginTextMuted}" FontSize="13.5"
                                   Margin="24,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Button Content="로그인" Command="{Binding LoginCommand}" IsDefault="True"
                        Background="{StaticResource LoginBlue}" Foreground="White" BorderThickness="0"
                        FontWeight="Bold" FontSize="14" Padding="10,14" Cursor="Hand" Margin="0,0,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="아이디 저장" Foreground="{StaticResource LoginTextMuted}" FontSize="12"
                              IsChecked="{Binding RememberLogin}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="아이디 찾기" Style="{StaticResource FooterLink}"/>
                        <TextBlock Text="  |  " Style="{StaticResource FooterLink}"/>
                        <TextBlock Text="비밀번호 찾기" Style="{StaticResource FooterLink}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource LoginErrorText}" TextWrapping="Wrap"
                           Margin="0,16,0,0"
                           Visibility="{Binding StatusText, Converter={StaticResource TruthyToVisibilityConverter}}"/>
            </StackPanel>

            <!-- 하단: 저작권 -->
            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                <TextBlock Text="© 2026 AI SMARTCRACK Co., Ltd." Foreground="{StaticResource LoginTextMuted}" FontSize="10.5"/>
                <TextBlock Text="All rights reserved." Foreground="{StaticResource LoginTextMuted}" FontSize="10.5"/>
            </StackPanel>
        </Grid>

        <!-- 오른쪽: 일러스트레이션 (드론이 외벽 균열을 스캔하는 이미지, 기존 그대로 유지).
             왼쪽 패널의 밝은 아쿠아 블루 배경(LoginPageBg, #EAF3FB)에서 사진으로 자연스럽게
             이어지도록 왼쪽 가장자리를 같은 색으로 페이드 아웃한다 (패널과 사진 사이 딱딱한
             경계선이 생기지 않게): 마지막 GradientStop의 #00EAF3FB는 LoginPageBg와 같은
             색의 완전 투명(alpha=00) 버전이어야 하므로 리소스 참조 대신 값을 직접 맞춰둔다. -->
        <Grid Grid.Column="1">
            <Image Source="/Assets/main_illustration2.png" Stretch="UniformToFill" ClipToBounds="True"/>
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#EAF3FB" Offset="0"/>
                        <GradientStop Color="#EAF3FB" Offset="0.06"/>
                        <GradientStop Color="#00EAF3FB" Offset="0.5"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </Grid>
</Window>
