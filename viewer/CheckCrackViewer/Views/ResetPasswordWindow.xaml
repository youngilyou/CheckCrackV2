<Window x:Class="CheckCrackViewer.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비밀번호 찾기" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#EAF3FB">
    <!-- 2026-10-07: 로그인 창 "비밀번호 찾기". 로컬 계정이라 외부 인증이 없으므로 다른 관리자 계정으로 확인 후 재설정. -->
    <StackPanel Margin="24">
        <TextBlock Text="비밀번호 재설정" FontSize="18" FontWeight="Bold" Foreground="#17222C" Margin="0,0,0,6"/>
        <TextBlock x:Name="GuideText" Foreground="#5B6B78" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="비밀번호를 잊은 아이디와, 이 PC의 다른 관리자 계정으로 확인한 뒤 새 비밀번호를 설정합니다."/>
        <TextBlock Text="비밀번호를 재설정할 아이디" Foreground="#5B6B78" Margin="0,0,0,4"/>
        <TextBox x:Name="TargetInput" Padding="8,6" FontSize="13"/>
        <TextBlock Text="새 비밀번호 (4자 이상)" Foreground="#5B6B78" Margin="0,10,0,4"/>
        <PasswordBox x:Name="NewPasswordInput" Padding="8,6" FontSize="13"/>
        <TextBlock Text="새 비밀번호 확인" Foreground="#5B6B78" Margin="0,10,0,4"/>
        <PasswordBox x:Name="ConfirmInput" Padding="8,6" FontSize="13"/>
        <Border BorderBrush="#C9D6E2" BorderThickness="0,1,0,0" Margin="0,16,0,10"/>
        <TextBlock Text="확인할 관리자 아이디 (다른 계정)" Foreground="#5B6B78" Margin="0,0,0,4"/>
        <TextBox x:Name="AdminInput" Padding="8,6" FontSize="13"/>
        <TextBlock Text="관리자 비밀번호" Foreground="#5B6B78" Margin="0,10,0,4"/>
        <PasswordBox x:Name="AdminPasswordInput" Padding="8,6" FontSize="13"/>
        <Button x:Name="ResetButton" Content="재설정" Click="Reset_Click" Margin="0,14,0,0" Padding="10,8" Background="#3B7DF2"
                Foreground="White" BorderThickness="0" FontWeight="Bold"/>
        <TextBlock x:Name="ResultText" Foreground="#E3543A" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <Button Content="닫기" Click="Close_Click" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="14,6"/>
    </StackPanel>
</Window>
