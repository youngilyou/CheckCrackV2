<Window x:Class="CheckCrackViewer.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비밀번호 재설정" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#EAF3FB">
    <!-- 2026-10-07: 로그인 창에서 Ctrl+R(숨김)로만 열린다. 아이디 + 새 비밀번호로 바로 재설정(사용자 결정). -->
    <StackPanel Margin="24">
        <TextBlock Text="비밀번호 재설정" FontSize="18" FontWeight="Bold" Foreground="#17222C" Margin="0,0,0,14"/>
        <TextBlock Text="아이디" Foreground="#5B6B78" Margin="0,0,0,4"/>
        <TextBox x:Name="TargetInput" Padding="8,6" FontSize="13"/>
        <TextBlock Text="새 비밀번호 (4자 이상)" Foreground="#5B6B78" Margin="0,10,0,4"/>
        <PasswordBox x:Name="NewPasswordInput" Padding="8,6" FontSize="13"/>
        <TextBlock Text="새 비밀번호 확인" Foreground="#5B6B78" Margin="0,10,0,4"/>
        <PasswordBox x:Name="ConfirmInput" Padding="8,6" FontSize="13"/>
        <Button x:Name="ResetButton" Content="재설정" Click="Reset_Click" Margin="0,14,0,0" Padding="10,8" Background="#3B7DF2"
                Foreground="White" BorderThickness="0" FontWeight="Bold" IsDefault="True"/>
        <TextBlock x:Name="ResultText" Foreground="#E3543A" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <Button Content="닫기" Click="Close_Click" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="14,6"/>
    </StackPanel>
</Window>
