<Window x:Class="CheckCrackViewer.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"
        Background="#0B0D0E" WindowStartupLocation="Manual">
    <Grid>
        <Grid x:Name="Viewport" ClipToBounds="True" Background="#0B0D0E"
              SizeChanged="Viewport_SizeChanged"
              MouseWheel="Canvas_MouseWheel"
              MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
              MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
              MouseMove="Canvas_MouseMove">
            <Canvas x:Name="ImageCanvas" Background="Transparent">
                <!-- No RenderTransform here on purpose: a ScaleTransform applied on
                     top of the image's full native (e.g. 1757x4000) intrinsic layout
                     size rendered as only a tiny corner under software rendering —
                     confirmed by A/B testing against plain Stretch="Uniform", which
                     rendered the full image correctly. So zoom/pan here instead set
                     Width/Height/Canvas.Left/Top directly every step, keeping the
                     element's actual layout size equal to what's genuinely visible. -->
                <Image x:Name="TheImage" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Fill"/>
            </Canvas>
        </Grid>

        <!-- toolbar -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#CC1C2124" CornerRadius="0,0,10,0" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="FileNameText" Foreground="#E7E9E4" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock x:Name="ZoomText" Foreground="#9AA39C" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="휠: 확대/축소 · 드래그: 이동 · Esc: 닫기" Foreground="#C7CDC8" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
