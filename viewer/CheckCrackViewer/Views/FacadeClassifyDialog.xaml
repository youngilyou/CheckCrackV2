<Window x:Class="CheckCrackViewer.Views.FacadeClassifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CheckCrackViewer.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:FacadeClassifyDialogViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Facade 분류" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Bg}">
    <StackPanel Margin="24">
        <TextBlock Text="FACADE 분류" Style="{StaticResource Kicker}" Margin="0,0,0,4"/>
        <TextBlock Text="단지 · 동(선택) · 방위를 확인/수정한 뒤 등록하세요." Foreground="{StaticResource Text2}"
                   FontSize="12" Margin="0,0,0,18" TextWrapping="Wrap"/>

        <TextBlock Text="단지명" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
        <TextBox Text="{Binding ComplexName, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,0,0,12"
                  Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>

        <TextBlock Text="동 이름 (선택)" Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,3"/>
        <TextBox Text="{Binding BuildingName, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,0,0,16"
                  Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>

        <TextBlock Text="방위" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
        <ItemsControl ItemsSource="{Binding Rows}" MaxHeight="280" Margin="0,0,0,20">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ClassifyRow}">
                    <Border Style="{StaticResource CardBorder}" Padding="10,7" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding FacadeId}" FontFamily="Consolas"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Side, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4" Background="{StaticResource Surface2}"
                                     Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Command="{Binding CancelCommand}" IsCancel="True" Padding="14,8" Margin="0,0,8,0"/>
            <Button Content="등록" Command="{Binding ConfirmCommand}" IsDefault="True" Padding="14,8"/>
        </StackPanel>
    </StackPanel>
</Window>
