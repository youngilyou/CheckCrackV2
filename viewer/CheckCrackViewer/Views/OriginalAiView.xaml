<UserControl x:Class="CheckCrackViewer.Views.OriginalAiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CheckCrackViewer.ViewModels"
             xmlns:models="clr-namespace:CheckCrackViewer.Models"
             d:DataContext="{d:DesignInstance Type=vm:OriginalAiViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ header ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Text2}" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="이미지 폴더 열기" Command="{Binding SelectImageFolderCommand}" Margin="0,0,8,0"/>

                <Button Content="크랙 탐지 실행" Command="{Binding DetectCracksCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsDetecting, Converter={StaticResource FalsyToVisibilityConverter}}"/>
                <TextBlock Text="탐지 중…" FontSize="11.5" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"
                           Visibility="{Binding IsDetecting, Converter={StaticResource TruthyToVisibilityConverter}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                            Visibility="{Binding HasImageList, Converter={StaticResource TruthyToVisibilityConverter}}">
                    <Button Content="◀ 이전" Command="{Binding PreviousImageCommand}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ImageListLabel}" Foreground="{StaticResource Text2}" FontFamily="Consolas" FontSize="11.5"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Content="다음 ▶" Command="{Binding NextImageCommand}"/>
                </StackPanel>

                <CheckBox Content="크랙 표시" IsChecked="{Binding ShowCrackOverlay}" VerticalAlignment="Center"
                          Visibility="{Binding HasImage, Converter={StaticResource TruthyToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <!-- ============ image + overlay ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10">
            <Grid>
                <TextBlock Text="&quot;이미지 폴더 열기&quot;로 원본 사진 폴더를 선택하세요."
                           Foreground="{StaticResource Text2}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasImage, Converter={StaticResource FalsyToVisibilityConverter}}"/>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasImage, Converter={StaticResource TruthyToVisibilityConverter}}">
                    <Grid Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                        <Image Source="{Binding DisplayBitmap}" Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Stretch="Fill"/>

                        <!-- YOLO 크랙 후보 오버레이. 체크박스 on일 때만 채워짐 (ViewModel.RebuildOverlay) -->
                        <ItemsControl ItemsSource="{Binding OverlayBoxes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:CrackBoxItem}">
                                    <Polygon Points="{Binding CanvasPoints}"
                                             Stroke="#FF5A5A" StrokeThickness="2"
                                             Fill="#334FA3FF" IsHitTestVisible="False"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
