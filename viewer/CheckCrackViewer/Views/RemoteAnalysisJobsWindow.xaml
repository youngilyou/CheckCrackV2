<Window x:Class="CheckCrackViewer.Views.RemoteAnalysisJobsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CheckCrackViewer.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:RemoteAnalysisJobsViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="원격 분석 작업" Width="820" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="원격 분석 작업" Style="{StaticResource Kicker}" Margin="0,0,0,4"/>
            <TextBlock Text="FacadePreviewer가 보낸 분석 실행 명령이 여기 표시됩니다 -- 다운로드/압축해제가 끝나면 자동으로 왼쪽 목록(메인 화면)에 등록되고 분석이 시작됩니다."
                       Foreground="{StaticResource Text2}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="10,7" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ID" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="회사/아파트" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="동/주소" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="방향" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold"/>
                <TextBlock Grid.Column="4" Text="장수" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold"/>
                <TextBlock Grid.Column="5" Text="상태" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold"/>
                <TextBlock Grid.Column="6" Text="진행/오류" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="Bold"/>
            </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Jobs}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RemoteAnalysisJobViewModel}">
                    <Border Style="{StaticResource CardBorder}" Padding="10,8" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ArchiveId}" FontFamily="Consolas" Foreground="{StaticResource Text}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Company}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding Building}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding DirectionsDisplay}" Foreground="{StaticResource Text2}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="4" Text="{Binding ImageCount}" Foreground="{StaticResource Text2}"/>
                            <TextBlock Grid.Column="5" Text="{Binding Status}" Foreground="{StaticResource Text}"/>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource Text2}" FontSize="11"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#E06C6C" FontSize="11" TextWrapping="Wrap"
                                           Visibility="{Binding ErrorMessage, Converter={StaticResource TruthyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
