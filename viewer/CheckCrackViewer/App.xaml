<Application x:Class="CheckCrackViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CheckCrackViewer"
             xmlns:conv="clr-namespace:CheckCrackViewer.Converters"
             xmlns:models="clr-namespace:CheckCrackViewer.Models">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ===== palette =====
                 2026-08-28: 로그인 후 화면(일반 배경/햄버거 사이드바 포함) 전체를 사용자가
                 지정한 어두운 무채색 계열로 전환: 기존엔 청록빛이 살짝 도는 검정
                 (#14181A 등)이었는데, 완전 중립(neutral) 톤의 짙은 회색으로 바꾼다.
                 Bg(일반 배경)/Surface(햄버거 사이드바)를 서로 다른 밝기로 두어 구별되게
                 하고, Surface2(카드/버튼)/Border는 그 위에 같은 간격으로 밝아지는 기존
                 구조를 그대로 유지한다. 로그인 화면(LoginWindow)은 별도 라이트 팔레트를
                 쓰므로 이 값들의 영향을 받지 않는다. -->
            <SolidColorBrush x:Key="Bg" Color="#2B2B2E"/>
            <SolidColorBrush x:Key="Surface" Color="#39393C"/>
            <SolidColorBrush x:Key="Surface2" Color="#45454A"/>
            <SolidColorBrush x:Key="Border" Color="#57575C"/>
            <SolidColorBrush x:Key="Text" Color="#E7E9E4"/>
            <SolidColorBrush x:Key="Text2" Color="#9AA39C"/>
            <SolidColorBrush x:Key="Text3" Color="#6F7872"/>
            <SolidColorBrush x:Key="Text4" Color="#37423C"/>
            <SolidColorBrush x:Key="Accent" Color="#FF6A3D"/>

            <!-- ===== converters ===== -->
            <conv:StatusToColorConverter x:Key="StatusToColorConverter"/>
            <conv:StatusToLabelConverter x:Key="StatusToLabelConverter"/>
            <conv:LevelToColorConverter x:Key="LevelToColorConverter"/>
            <conv:PathToBitmapConverter x:Key="PathToBitmapConverter"/>
            <conv:RatioToPercentConverter x:Key="RatioToPercentConverter"/>
            <conv:PxValueConverter x:Key="PxValueConverter"/>
            <conv:TruthyToVisibilityConverter x:Key="TruthyToVisibilityConverter"/>
            <conv:TruthyToVisibilityConverter x:Key="FalsyToVisibilityConverter" Invert="True"/>
            <conv:TruthyToBoolConverter x:Key="TruthyToBoolConverter"/>
            <conv:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibilityConverter"/>
            <conv:StringEqualsToVisibilityConverter x:Key="StringNotEqualsToVisibilityConverter" Invert="True"/>
            <conv:StringEqualsToBoolConverter x:Key="StringNotEqualsToBoolConverter" Invert="True"/>
            <conv:TwoStringsEqualToBrushConverter x:Key="TwoStringsEqualToBrushConverter"/>
            <conv:RowAndFacadeToRequestConverter x:Key="RowAndFacadeToRequestConverter"/>
            <conv:ReferenceEqualsToBrushConverter x:Key="ReferenceEqualsToBrushConverter"/>

            <!-- ===== base styles ===== -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource Bg}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontFamily" Value="맑은 고딕"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style x:Key="Kicker" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Text2}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Surface2}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="{StaticResource Surface}"/>
            </Style>

            <!-- FACADES 계층 트리(단지/동/방위) 그룹 헤더 스타일 — 기본 Expander 크롬 위에
                 앱 다크 테마 색만 얹음. 분석·스티칭 화면(MainWindow)과 결과보기 화면
                 (ResultsCompareView) 둘 다 같은 트리 구조를 쓰므로 앱 전역에 둔다. -->
            <Style x:Key="TreeGroupExpander" TargetType="Expander">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>

            <!-- LIVE LOG 패널(MainWindow, 분석·스티칭 탭)과 설정 > 시스템 상태 탭의 "오류/로그"
                 카드가 공유하는 로그 한 줄 템플릿. 두 화면이 서로 다른 XAML 파일(MainWindow.xaml/
                 SettingsView.xaml)이라 앱 전역 리소스로 둔다. -->
            <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type models:PipelineLogEntry}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Level}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                   Foreground="{Binding Level, Converter={StaticResource LevelToColorConverter}}" Width="52"/>
                        <TextBlock Text="{Binding FacadeId}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Accent}" Margin="4,0,0,0"/>
                        <TextBlock Text="{Binding Stage}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Text2}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0" Foreground="{StaticResource Text}"/>
                    <TextBlock Text="{Binding Progress}" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource Text2}"
                                Visibility="{Binding Progress, Converter={StaticResource TruthyToVisibilityConverter}}"/>
                </StackPanel>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
